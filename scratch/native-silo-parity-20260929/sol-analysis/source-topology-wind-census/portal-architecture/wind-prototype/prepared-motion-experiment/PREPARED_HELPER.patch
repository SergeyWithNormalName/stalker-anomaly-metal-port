+// Owns one immutable frame snapshot so no pointer can outlive its source.
+// A cached motion error is reported only after each Rest's original validation
+// point, preserving compute(Rest, Motion)'s per-record failure precedence.
+struct PreparedMotion
+{
+    Motion motion{};
+    const char* validationError = nullptr;
+    double speed = 0.0;
+    double wSpeed = 0.0;
+    double tWaveAbs = 0.0;
+    double trunkZ = 0.0;
+};
+
+inline PreparedMotion prepareMotion(const Motion& motion)
+{
+    PreparedMotion prepared;
+    prepared.motion = motion;
+    if (!motion.valid) { prepared.validationError = "invalid_motion_snapshot"; return prepared; }
+    for (float v : motion.windParams)
+        if (!std::isfinite(v)) { prepared.validationError = "nonfinite_wind_params"; return prepared; }
+    for (float v : motion.treeSetup)
+        if (!std::isfinite(v)) { prepared.validationError = "nonfinite_tree_setup"; return prepared; }
+    for (float v : motion.benderSetup)
+        if (!std::isfinite(v)) { prepared.validationError = "nonfinite_bender_setup"; return prepared; }
+    for (float v : motion.animationCurrent)
+        if (!std::isfinite(v)) { prepared.validationError = "nonfinite_current_animation"; return prepared; }
+    for (float v : motion.animationPrevious)
+        if (!std::isfinite(v)) { prepared.validationError = "nonfinite_previous_animation"; return prepared; }
+    for (const Vec4& v : motion.currentBenders)
+        if (!finite4(v)) { prepared.validationError = "nonfinite_current_bender"; return prepared; }
+    for (const Vec4& v : motion.previousBenders)
+        if (!finite4(v)) { prepared.validationError = "nonfinite_previous_bender"; return prepared; }
+
+    prepared.speed = std::max(static_cast<double>(motion.treeSetup[3]),
+        saturate(static_cast<double>(motion.windParams[1]) * 0.001));
+    prepared.wSpeed = saturate(std::sqrt(prepared.speed * 1.66) * 1.5);
+    prepared.tWaveAbs = 1.5 * std::abs(static_cast<double>(motion.treeSetup[2])) * (1.0 + 2e-6);
+    prepared.trunkZ = saturate((1.0 + prepared.tWaveAbs) * 0.5);
+    return prepared;
+}
