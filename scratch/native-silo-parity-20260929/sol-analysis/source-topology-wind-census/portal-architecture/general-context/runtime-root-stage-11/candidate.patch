+
+struct MainFloraDeferredPortalContext
+{
+    const xray::metal::R4PortalGenerationCache* cache = nullptr;
+    const xray::metal::R4PortalContextFrameInput* input = nullptr;
+    const xray::metal::R4PortalContextFrameOutput* portal = nullptr;
+    const std::vector<const R4FloraRestRecord*>* restByVisualId = nullptr;
+    flora_wind::PreparedMotion preparedMotion;
+    bool valid = false;
+};
+
+flora_wind::Motion makeFloraMotion(const R4FloraViewState& view)
+{
+    flora_wind::Motion motion;
+    motion.valid = view.windValid;
+    motion.windParams = view.windParams;
+    motion.treeSetup = view.windSetupTrees;
+    motion.benderSetup = view.bendersSetup;
+    motion.animationCurrent = view.windAnimation;
+    motion.animationPrevious = view.windAnimationPrevious;
+    for (std::size_t i = 0; i < motion.currentBenders.size(); ++i)
+    {
+        motion.currentBenders[i] = {view.currentBenders[i][0], view.currentBenders[i][1],
+            view.currentBenders[i][2], view.currentBenders[i][3]};
+        motion.previousBenders[i] = {view.previousBenders[i][0], view.previousBenders[i][1],
+            view.previousBenders[i][2], view.previousBenders[i][3]};
+    }
+    return motion;
+}
+
+bool prepareMainFloraDeferredPortalContext(
+    const xray::metal::R4PortalGenerationCache& cache,
+    const xray::metal::R4PortalContextFrameInput& input,
+    const xray::metal::R4PortalContextFrameOutput& portal,
+    const std::vector<const R4FloraRestRecord*>& restByVisualId,
+    const R4FloraViewState& view,
+    const bool motionSnapshotFresh,
+    const bool environmentSnapshotFresh,
+    MainFloraDeferredPortalContext& output)
+{
+    output = {};
+    if (!cache.qualified || !portal.valid || !view.valid || !view.windValid ||
+        !motionSnapshotFresh || !environmentSnapshotFresh || input.generation == 0u ||
+        input.generation != cache.generation || portal.generation != input.generation ||
+        portal.frameID != input.frameID || view.engineFrame != input.frameID ||
+        restByVisualId.size() != cache.graph.visualNodes.size() ||
+        restByVisualId.size() > portal.graph.rawVisualVisible.size() ||
+        std::memcmp(view.view.data(), input.currentView.data(), sizeof(float) * 16u) != 0 ||
+        std::memcmp(view.projection.data(), input.currentProjection.data(), sizeof(float) * 16u) != 0 ||
+        !portalFullTransformMatchesSourceOrder(input))
+        return false;
+    output.cache = &cache;
+    output.input = &input;
+    output.portal = &portal;
+    output.restByVisualId = &restByVisualId;
+    output.preparedMotion = flora_wind::prepareMotion(makeFloraMotion(view));
+    if (output.preparedMotion.validationError)
+    { output = {}; return false; }
+    output.valid = true;
+    return true;
+}
+
+bool shouldSkipMainFloraVisualAfterCameraClip(void* opaque, const std::uint32_t visualId,
+    R4FloraDeferredPortalStats& stats) noexcept
+{
+    auto* context = static_cast<MainFloraDeferredPortalContext*>(opaque);
+    if (!context || !context->valid || !context->cache || !context->input ||
+        !context->portal || !context->restByVisualId)
+    { ++stats.unknownKeptVisible; return false; }
+    try
+    {
+        const auto& restById = *context->restByVisualId;
+        const auto& portal = *context->portal;
+        const auto& cache = *context->cache;
+        if (visualId >= restById.size() || visualId >= portal.graph.rawVisualVisible.size() ||
+            visualId >= cache.graph.portalMetadata.visualOwnerSectors.size())
+        { ++stats.unknownKeptVisible; return false; }
+        const R4FloraRestRecord* record = restById[visualId];
+        if (!record || !record->known || !record->eligible)
+        { ++stats.unknownKeptVisible; return false; }
+        if (portal.graph.rawVisualVisible[visualId] != 0u)
+            return false;
+
+        ++stats.portalCandidateDraws;
+        flora_wind::Rest rest;
+        rest.center = {record->worldSphereCenter[0], record->worldSphereCenter[1], record->worldSphereCenter[2]};
+        rest.radius = record->radius;
+        rest.hMin = record->minH;
+        rest.hMax = record->maxH;
+        rest.uvAbsMax = record->maxAbsOneMinusUvY;
+        rest.material = record->leaf ? flora_wind::Material::Leaf : flora_wind::Material::Trunk;
+        ++stats.windBoundCalls;
+        const flora_wind::Bound bound = flora_wind::compute(rest, context->preparedMotion);
+        if (!bound.known || !std::isfinite(bound.unionRadius) || bound.unionRadius <= 0.0f)
+        { ++stats.windBoundUnknown; ++stats.unknownKeptVisible; return false; }
+
+        const auto& owners = cache.graph.portalMetadata.visualOwnerSectors[visualId];
+        if (owners.empty())
+        { ++stats.ownerFrustumUnknown; ++stats.unknownKeptVisible; return false; }
+        ++stats.ownerRecordChecks;
+        Fvector center; center.set(record->worldSphereCenter[0], record->worldSphereCenter[1], record->worldSphereCenter[2]);
+        bool allOwnerFrustaMiss = true;
+        for (const std::uint32_t owner : owners)
+        {
+            if (owner >= portal.graph.reached.size() || portal.graph.reached[owner].values.empty())
+            { ++stats.ownerFrustumUnknown; ++stats.unknownKeptVisible; return false; }
+            for (const CFrustum& frustum : portal.graph.reached[owner].values)
+            {
+                ++stats.ownerFrustumTests;
+                Fvector testCenter = center;
+                if (frustum.testSphere_dirty(testCenter, bound.unionRadius))
+                { allOwnerFrustaMiss = false; break; }
+            }
+            if (!allOwnerFrustaMiss) break;
+        }
+        return allOwnerFrustaMiss;
+    }
+    catch (...)
+    { ++stats.unknownKeptVisible; return false; }
 }
 
