+// Borrowed only for the synchronous main LMH draw.  Callers construct this
+// after matching the observer result to the current primary ViewState; null or
+// unqualified contexts mean draw every admitted visual.
+struct R4PortalMainPassContext
+{
+    const R4PortalGenerationCache* cache = nullptr;
+    const R4PortalContextFrameInput* input = nullptr;
+    const R4PortalContextFrameOutput* output = nullptr;
+    u32 frameID = u32(-1);
+    bool requested = false;
+    bool suppress = false;
+    bool sourceOrderFullTransformMatches = false;
+};
