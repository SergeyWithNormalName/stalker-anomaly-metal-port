+// LMH portal predicate for the main pass only. Unknown topology, bounds,
+// transforms, owner IDs, or frustum records always keep the draw.
+bool portalOutsideEveryOwnerFrustum(
+    const xray::metal::R4PortalMainPassContext& context,
+    const LevelScene& scene, const xray::metal::R4StaticVisual& visual,
+    const LevelScene::TextureMaterial& binding)
+{
+    if (!context.cache || !context.output || !context.output->valid ||
+        !context.output->graph.valid || !scene.geometry.portalMetadata.available ||
+        visual.visualId >= scene.geometry.portalMetadata.visualOwnerSectors.size() ||
+        visual.visualId >= scene.geometry.visualNodes.size() ||
+        !visual.referencedPositionBounds.available ||
+        !binding.localPositionBounds.available || !finiteMatrix(binding.modelTransform) ||
+        binding.modelTransform.elements[3] != 0.f || binding.modelTransform.elements[7] != 0.f ||
+        binding.modelTransform.elements[11] != 0.f || binding.modelTransform.elements[15] != 1.f)
+        return false;
+
+    const auto& owners = scene.geometry.portalMetadata.visualOwnerSectors[visual.visualId];
+    const auto& sectors = scene.geometry.portalMetadata.sectors;
+    const auto& reached = context.output->graph.reached;
+    if (owners.empty() || reached.size() != sectors.size())
+        return false;
+    const auto& local = visual.referencedPositionBounds;
+    for (unsigned axis = 0; axis != 3; ++axis)
+        if (!std::isfinite(local.minimum[axis]) || !std::isfinite(local.maximum[axis]) ||
+            local.minimum[axis] > local.maximum[axis] ||
+            local.minimum[axis] != binding.localPositionBounds.minimum[axis] ||
+            local.maximum[axis] != binding.localPositionBounds.maximum[axis])
+            return false;
+
+    float worldBox[6] = {
+        std::numeric_limits<float>::infinity(), std::numeric_limits<float>::infinity(),
+        std::numeric_limits<float>::infinity(), -std::numeric_limits<float>::infinity(),
+        -std::numeric_limits<float>::infinity(), -std::numeric_limits<float>::infinity()};
+    for (const float x : {local.minimum[0], local.maximum[0]})
+        for (const float y : {local.minimum[1], local.maximum[1]})
+            for (const float z : {local.minimum[2], local.maximum[2]})
+            {
+                const Vec3 world = transformPoint(binding.modelTransform, {x, y, z});
+                if (!std::isfinite(world.x) || !std::isfinite(world.y) || !std::isfinite(world.z))
+                    return false;
+                worldBox[0] = std::min(worldBox[0], world.x);
+                worldBox[1] = std::min(worldBox[1], world.y);
+                worldBox[2] = std::min(worldBox[2], world.z);
+                worldBox[3] = std::max(worldBox[3], world.x);
+                worldBox[4] = std::max(worldBox[4], world.y);
+                worldBox[5] = std::max(worldBox[5], world.z);
+            }
+    const float boxMargin = std::max(1.0e-3f,
+        std::max(worldBox[3] - worldBox[0],
+            std::max(worldBox[4] - worldBox[1], worldBox[5] - worldBox[2])) * 1.0e-5f);
+    for (unsigned axis = 0; axis != 3; ++axis)
+    {
+        worldBox[axis] -= boxMargin;
+        worldBox[axis + 3u] += boxMargin;
+        if (!std::isfinite(worldBox[axis]) || !std::isfinite(worldBox[axis + 3u]))
+            return false;
+    }
+    Fvector center;
+    center.set((worldBox[0] + worldBox[3]) * 0.5f,
+        (worldBox[1] + worldBox[4]) * 0.5f, (worldBox[2] + worldBox[5]) * 0.5f);
+    const float dx = worldBox[3] - center.x;
+    const float dy = worldBox[4] - center.y;
+    const float dz = worldBox[5] - center.z;
+    float radius = std::sqrt(dx * dx + dy * dy + dz * dz);
+    if (!std::isfinite(radius))
+        return false;
+    radius += std::max(1.0e-3f, radius * 1.0e-5f);
+
+    for (const std::uint32_t owner : owners)
+    {
+        if (owner >= sectors.size() || owner >= reached.size() ||
+            sectors[owner].sectorId != owner || reached[owner].sectorId != owner)
+            return false;
+        for (const CFrustum& frustum : reached[owner].values)
+        {
+            std::uint32_t mask = frustum.getMask();
+            if (frustum.testSAABB(center, radius, worldBox, mask) != fcvNone)
+                return false;
+        }
+    }
+    return true;
+}
+
+bool isPortalLmhVisual(const LevelScene& scene,
+    const xray::metal::R4StaticVisual& visual,
+    const LevelScene::TextureMaterial& binding)
+{
+    if (binding.visualId != visual.visualId || binding.shaderId != visual.shaderId ||
+        visual.shaderId >= scene.geometry.shaders.size())
+        return false;
+    const auto& textures = scene.geometry.shaders[visual.shaderId].textures;
+    return textures.size() >= 3u && textures[2].rfind("lmap#", 0u) == 0u;
+}
