+bool buildMainFloraPortalCandidateSet(
+    const xray::metal::R4PortalGenerationCache& cache,
+    const xray::metal::R4PortalContextFrameInput& input,
+    const xray::metal::R4PortalContextFrameOutput& portal,
+    const std::vector<R4FloraRestRecord>& restRecords,
+    const R4FloraViewState& frozenView,
+    const bool selectedPrimaryViewMatches,
+    MetalR4EngineScene::MainFloraPortalCandidateSet& result)
+{
+    result = {};
+    result.generation = input.generation;
+    result.engineFrame = input.frameID;
+    result.sourceOrderFullTransformMatches = portalFullTransformMatchesSourceOrder(input);
+    if (!cache.qualified || !portal.valid || input.frameID != 700u ||
+        input.generation == 0u || input.generation != cache.generation ||
+        !selectedPrimaryViewMatches || !result.sourceOrderFullTransformMatches ||
+        !frozenView.valid || !frozenView.windValid || frozenView.engineFrame != input.frameID ||
+        std::memcmp(frozenView.view.data(), input.currentView.data(), sizeof(float) * 16u) != 0 ||
+        std::memcmp(frozenView.projection.data(), input.currentProjection.data(), sizeof(float) * 16u) != 0)
+    { result.reason = "stale-generation-or-primary-source-view-mismatch"; return false; }
+
+    flora_wind::Motion motion;
+    motion.valid = frozenView.windValid;
+    motion.windParams = frozenView.windParams;
+    motion.treeSetup = frozenView.windSetupTrees;
+    motion.benderSetup = frozenView.bendersSetup;
+    motion.animationCurrent = frozenView.windAnimation;
+    motion.animationPrevious = frozenView.windAnimationPrevious;
+    for (std::size_t i = 0; i < motion.currentBenders.size(); ++i)
+    {
+        motion.currentBenders[i] = {frozenView.currentBenders[i][0], frozenView.currentBenders[i][1],
+            frozenView.currentBenders[i][2], frozenView.currentBenders[i][3]};
+        motion.previousBenders[i] = {frozenView.previousBenders[i][0], frozenView.previousBenders[i][1],
+            frozenView.previousBenders[i][2], frozenView.previousBenders[i][3]};
+    }
+
+    std::unordered_set<std::uint32_t> seen;
+    for (const R4FloraRestRecord& record : restRecords)
+    {
+        if (!seen.insert(record.visualId).second)
+        { result.reason = "duplicate-rest-record-id"; result.excludedVisualIds.clear(); return false; }
+        if (!record.known || !record.eligible || record.visualId >= portal.graph.rawVisualVisible.size() ||
+            record.visualId >= cache.graph.portalMetadata.visualOwnerSectors.size())
+        { ++result.windBoundUnknown; continue; }
+        if (portal.graph.rawVisualVisible[record.visualId] != 0u)
+            continue; // Source portal test is only a broad-phase candidate, never the wind proof.
+        ++result.rawPortalCandidates;
+
+        flora_wind::Rest rest;
+        rest.center = {record.worldSphereCenter[0], record.worldSphereCenter[1], record.worldSphereCenter[2]};
+        rest.radius = record.radius;
+        rest.hMin = record.minH;
+        rest.hMax = record.maxH;
+        rest.uvAbsMax = record.maxAbsOneMinusUvY;
+        rest.material = record.leaf ? flora_wind::Material::Leaf : flora_wind::Material::Trunk;
+        const flora_wind::Bound bound = flora_wind::compute(rest, motion);
+        if (!bound.known || !std::isfinite(bound.unionRadius) || bound.unionRadius <= 0.0f)
+        { ++result.windBoundUnknown; continue; }
+
+        const auto& owners = cache.graph.portalMetadata.visualOwnerSectors[record.visualId];
+        if (owners.empty()) { ++result.ownerFrustumUnknown; continue; }
+        Fvector center; center.set(record.worldSphereCenter[0], record.worldSphereCenter[1], record.worldSphereCenter[2]);
+        bool allOwnerFrustaMiss = true;
+        bool ownerSetKnown = true;
+        for (const std::uint32_t owner : owners)
+        {
+            if (owner >= portal.graph.reached.size() || portal.graph.reached[owner].values.empty())
+            { ownerSetKnown = false; break; }
+            for (const CFrustum& frustum : portal.graph.reached[owner].values)
+            {
+                Fvector testCenter = center;
+                if (frustum.testSphere_dirty(testCenter, bound.unionRadius))
+                { allOwnerFrustaMiss = false; break; }
+            }
+            if (!allOwnerFrustaMiss) break;
+        }
+        if (!ownerSetKnown) { ++result.ownerFrustumUnknown; continue; }
+        if (allOwnerFrustaMiss)
+            result.excludedVisualIds.push_back(record.visualId);
+    }
+    result.qualified = true;
+    result.reason.clear();
+    return true;
 }
