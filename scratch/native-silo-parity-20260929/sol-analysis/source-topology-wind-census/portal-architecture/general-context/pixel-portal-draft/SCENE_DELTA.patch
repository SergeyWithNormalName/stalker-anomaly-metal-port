+bool portalFullTransformMatchesSourceOrder(const xray::metal::R4PortalContextFrameInput& input)
+{
+    Fmatrix sourceView, sourceProjection, sourceFull, expected;
+    std::memcpy(&sourceView, input.currentView.data(), sizeof(sourceView));
+    std::memcpy(&sourceProjection, input.currentProjection.data(), sizeof(sourceProjection));
+    std::memcpy(&sourceFull, &input.fullTransform, sizeof(sourceFull));
+    expected.mul(sourceProjection, sourceView); // xrEngine/device.cpp: mFullTransform.mul(mProject,mView)
+    return std::memcmp(&expected, &sourceFull, sizeof(expected)) == 0;
+}
