+bool runMainFloraPixelPairOracle(IR4Backend& backend, LevelScene& scene,
+    const MetalR4EngineScene::ViewState& view,
+    const std::shared_ptr<const R4EngineWorldSnapshot>& world,
+    const R4RenderPassDesc& productionPass,
+    const std::shared_ptr<const MetalR4EngineScene::MainFloraOraclePrepareCallback>& prepare,
+    const std::shared_ptr<const MetalR4EngineScene::MainFloraOracleDrawCallback>& draw,
+    std::string& error)
+{
+    const char* directory = std::getenv("XRAY_METAL_FLORA_MAIN_PIXEL_PAIR_DIR");
+    const char* frameText = std::getenv("XRAY_METAL_FLORA_MAIN_PIXEL_PAIR_FRAME");
+    if (!directory || !*directory || !frameText || !prepare || !draw || !view.valid)
+        return true;
+    const char* modeText = std::getenv("XRAY_METAL_FLORA_MAIN_PIXEL_PAIR_MODE");
+    const std::string mode = modeText && *modeText ? modeText : "off-off";
+    if (mode != "off-off" && mode != "source-vs-portals")
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=mode reason=unknown-mode\n");
+        return true;
+    }
+    const bool portalOnBranch = mode == "source-vs-portals";
+    if (!*frameText || !std::all_of(frameText, frameText + std::strlen(frameText),
+            [](unsigned char ch) { return ch >= '0' && ch <= '9'; }))
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=frame reason=frame-must-be-decimal-uint32\n");
+        return true;
+    }
+    char* frameEnd = nullptr;
+    errno = 0;
+    const unsigned long requestedFrame = std::strtoul(frameText, &frameEnd, 10);
+    if (errno == ERANGE || !frameEnd || *frameEnd || requestedFrame > UINT32_MAX ||
+        requestedFrame != view.engineFrame)
+        return true;
+    if (!prepare || !*prepare || !draw || !*draw)
+        return true;
+
+    MainFloraPixelPairTargets localTargets;
+    MainFloraPixelPairTargets* targets = &localTargets;
+    if (!ensureMainFloraPixelPairTargets(backend, scene, *targets, error))
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=targets error=%s\n", error.c_str());
+        error.clear();
+        return true;
+    }
+    R4FloraViewState frozenFloraView;
+    MetalR4EngineScene::MainFloraPortalCandidateSet candidates;
+    if (!(*prepare)(view, world, frozenFloraView, portalOnBranch, candidates, error) || !frozenFloraView.valid)
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=prepare error=%s\n", error.c_str());
+        error.clear();
+        return true;
+    }
+    if (portalOnBranch && (!candidates.qualified || candidates.engineFrame != view.engineFrame ||
+            candidates.excludedVisualIds.empty() || !candidates.sourceOrderFullTransformMatches))
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=portal-candidates excluded=%zu reason=%s\n",
+            candidates.excludedVisualIds.size(), candidates.reason.c_str());
+        error.clear();
+        return true;
+    }
+    std::error_code filesystemError;
+    std::filesystem::create_directories(directory, filesystemError);
+    if (filesystemError)
+    {
+        std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR_REJECT phase=output error=%s\n",
+            filesystemError.message().c_str());
+        return true;
+    }
+
+    bool passActive = true;
+    const auto resumeProductionPass = [&]() {
+        R4RenderPassDesc resume = productionPass;
+        resume.label = "R4 engine scene G-buffer after Flora pixel-pair diagnostic";
+        for (R4ColorAttachmentDesc& attachment : resume.colorAttachments)
+        { attachment.loadAction = R4LoadAction::Load; attachment.storeAction = R4StoreAction::Store; }
+        resume.depthStencilAttachment.depthLoadAction = R4LoadAction::Load;
+        resume.depthStencilAttachment.depthStoreAction = R4StoreAction::Store;
+        resume.depthStencilAttachment.stencilLoadAction = R4LoadAction::Load;
+        resume.depthStencilAttachment.stencilStoreAction = R4StoreAction::Store;
+        if (!backend.BeginRenderPass(resume, error) || !backend.SetStencilReference(1u, error))
+            return false;
