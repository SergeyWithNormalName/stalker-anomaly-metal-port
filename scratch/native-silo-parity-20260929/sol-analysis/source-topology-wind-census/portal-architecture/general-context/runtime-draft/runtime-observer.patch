+bool MetalR4FloraAdapter::HasShadowCasters() const
+{
+    return m_ready && m_impl && m_impl->leafShadowPipeline &&
+        m_impl->leafNoAlphaShadowPipeline && m_impl->trunkShadowPipeline;
