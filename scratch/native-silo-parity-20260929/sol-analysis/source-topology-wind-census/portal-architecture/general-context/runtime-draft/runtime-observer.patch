+bool MetalR4EngineScene::ObservePortalFrame(
+    const xray::metal::R4PortalContextFrameInput& input, CDB::MODEL* borrowedStaticCform)
+{
+    if (!impl || !impl->portalObserverEnabled || input.frameID != 700u || impl->portalAttempted)
+        return false;
+    impl->portalAttempted = true;
+    impl->portalInput = input;
+    impl->portalOutput = {};
+    impl->portalOutput.generation = input.generation;
+    impl->portalOutput.frameID = input.frameID;
+    impl->portalOutput.initializationCpuMs = impl->portalCache.initializationCpuMs;
+    impl->portalPending = true;
+    impl->portalSelectedViewMatches = false;
+    impl->portalWasSubmitted = false;
+    const auto frameStart = std::chrono::steady_clock::now();
+    if (input.generation == 0 || input.generation != impl->portalCache.generation ||
+        !impl->portalCache.qualified)
+        impl->portalOutput.unavailableReason = impl->portalCache.unavailableReason.empty() ?
+            "stale-or-unqualified-runtime-generation" : impl->portalCache.unavailableReason;
+    else
+    {
+        // borrowedStaticCform is consumed synchronously by the detector and never stored.
+        xray::metal::ObserveR4PortalGeneration(impl->portalCache, input,
+            borrowedStaticCform, impl->portalOutput);
+    }
+    impl->portalOutput.frameCpuMs = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - frameStart).count();
+    impl->portalOutput.initializationCpuMs = impl->portalCache.initializationCpuMs;
+    return impl->portalOutput.valid;
+}
+
 void MetalR4EngineScene::OnFrameSubmitted()
 {
     if (!impl) return;
+    if (impl->portalPending && !impl->portalWasSubmitted)
+    {
+        impl->portalWasSubmitted = true;
+        bool idsValid = false;
+        std::vector<std::pair<std::uint32_t, std::string>> ids;
+        const char* idDirectory = std::getenv("XRAY_METAL_MAIN_FLORA_IDS_DIR");
+        if (idDirectory && idDirectory[0] == '/')
+        {
+            std::ifstream idsFile(std::filesystem::path(idDirectory) / "main-flora-ids-frame-700.csv");
+            std::string line;
+            bool footer = false, footerSeen = false, header = false, malformedIds = false;
+            bool frameMetadata = false, extentMetadata = false;
+            std::unordered_set<std::uint32_t> seen;
+            try
+            {
+                while (std::getline(idsFile, line))
+                {
+                    if (footerSeen) { malformedIds = true; ids.clear(); break; }
+                    if (line == "visual_id,material") { if (header) { ids.clear(); break; } header = true; continue; }
+                    if (line == "engine_frame,700") { frameMetadata = true; continue; }
+                    if (line == "extent," + std::to_string(impl->portalInput.width) + "," +
+                        std::to_string(impl->portalInput.height)) { extentMetadata = true; continue; }
+                    if (line.rfind("encode_complete,", 0) == 0)
+                    {
+                        footerSeen = true;
+                        footer = line == "encode_complete,5316" && ids.size() == 5316u;
+                        if (!footer) malformedIds = true;
+                        continue;
+                    }
+                    if (!header || line.empty() || line[0] == '#') continue;
+                    const auto comma = line.find(',');
+                    if (comma == std::string::npos) { ids.clear(); break; }
+                    std::size_t parsedChars = 0;
+                    const unsigned long parsedId = std::stoul(line.substr(0, comma), &parsedChars, 10);
+                    if (parsedChars != comma || parsedId > std::numeric_limits<std::uint32_t>::max())
+                    { malformedIds = true; ids.clear(); break; }
+                    const auto id = static_cast<std::uint32_t>(parsedId);
+                    const std::string material = line.substr(comma + 1u);
+                    if ((material != "leaf" && material != "trunk") || !seen.insert(id).second)
+                    { ids.clear(); break; }
+                    ids.emplace_back(id, material);
+                }
+                idsValid = bool(idsFile.eof()) && header && footerSeen && footer &&
+                    !malformedIds && frameMetadata && extentMetadata && ids.size() == 5316u;
+            }
+            catch (...) { ids.clear(); idsValid = false; }
+        }
+        const auto csvBitsMatch = [](const std::string& line, const char* key,
+            const float* expected, std::size_t count) {
+            const std::string prefix = std::string(key) + ",";
+            if (line.rfind(prefix, 0) != 0) return false;
+            std::istringstream input(line.substr(prefix.size()));
+            std::string token;
+            for (std::size_t i = 0; i < count; ++i)
+            {
+                if (!std::getline(input, token, ',' ) || token.size() != 8u) return false;
+                char* end = nullptr;
+                const unsigned long bits = std::strtoul(token.c_str(), &end, 16);
+                std::uint32_t expectedBits = 0;
+                std::memcpy(&expectedBits, expected + i, sizeof(expectedBits));
+                if (!end || *end || bits != expectedBits) return false;
+            }
+            return !std::getline(input, token, ',');
+        };
+        std::array<float,3> expectedEye{{impl->portalInput.currentEye.x,
+            impl->portalInput.currentEye.y, impl->portalInput.currentEye.z}};
+        const std::array<float,7> expectedSsa{{impl->portalInput.fovDegrees,
+            impl->portalInput.geometryLod, impl->portalInput.discardPixels,
+            impl->portalInput.discardExponent, impl->portalInput.discardFadeK,
+            impl->portalInput.screenFactor, impl->portalInput.effectiveDiscard}};
+        unsigned csvViewMatches = 0, csvProjectionMatches = 0, csvEyeMatches = 0, csvSsaMatches = 0;
+        if (idDirectory && idDirectory[0] == '/')
+        {
+            std::ifstream check(std::filesystem::path(idDirectory) / "main-flora-ids-frame-700.csv");
+            std::string line;
+            while (std::getline(check, line))
+            {
+                csvViewMatches += csvBitsMatch(line, "view_bits", impl->portalInput.currentView.data(), 16u) ? 1u : 0u;
+                csvProjectionMatches += csvBitsMatch(line, "projection_bits", impl->portalInput.currentProjection.data(), 16u) ? 1u : 0u;
+                csvEyeMatches += csvBitsMatch(line, "eye_bits", expectedEye.data(), 3u) ? 1u : 0u;
+                csvSsaMatches += csvBitsMatch(line, "ssa_settings_bits", expectedSsa.data(), 7u) ? 1u : 0u;
+            }
+        }
+        const bool csvViewMatch = csvViewMatches == 1u;
+        const bool csvProjectionMatch = csvProjectionMatches == 1u;
+        const bool csvEyeMatch = csvEyeMatches == 1u;
+        const bool csvSsaMatch = csvSsaMatches == 1u;
+        bool idsIndicesValid = impl->portalOutput.valid;
+        for (const auto& row : ids)
+            idsIndicesValid = idsIndicesValid && row.first < impl->portalOutput.graph.rawVisualVisible.size() &&
+                row.first < impl->portalOutput.graph.ownerFrustumTests.size();
+        idsValid = idsValid && csvViewMatch && csvProjectionMatch && csvEyeMatch &&
+            csvSsaMatch && idsIndicesValid;
+        const bool complete = impl->portalOutput.valid && impl->portalSelectedViewMatches && idsValid;
+        const char* receiptPath = std::getenv("XRAY_METAL_SOURCE_TOPOLOGY_FILE");
+        if (receiptPath && receiptPath[0] == '/')
+        {
+            std::ofstream receipt(receiptPath, std::ios::binary | std::ios::trunc);
+            receipt.imbue(std::locale::classic());
+            receipt << std::setprecision(std::numeric_limits<double>::max_digits10) << std::boolalpha;
+            const auto writeBits = [&receipt](const char* name, const float* values, std::size_t count) {
+                receipt << "\"" << name << "\":[";
+                for (std::size_t i = 0; i < count; ++i) {
+                    std::uint32_t bits = 0; std::memcpy(&bits, values + i, sizeof(bits));
+                    if (i) receipt << ','; receipt << bits;
+                }
+                receipt << "],";
+            };
+            const std::array<float,3> currentEye{{impl->portalInput.currentEye.x,
+                impl->portalInput.currentEye.y, impl->portalInput.currentEye.z}};
+            const std::array<float,3> savedEye{{impl->portalInput.savedEye.x,
+                impl->portalInput.savedEye.y, impl->portalInput.savedEye.z}};
+            receipt << "{\n\"schema\":\"r4-source-topology-runtime-v1\",\n"
+                << "\"complete\":" << complete << ",\"suppressed\":0,\n";
+            writeBits("current_eye_bits", currentEye.data(), currentEye.size());
