@@ -0,0 +1,93 @@
+#pragma once
+
+#include "R4LevelGeometry.h"
+#include "R4PortalGraphObserver.h"
+#include "xrCDB/xrCDB.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace xray::metal
+{
+struct R4PortalPlaneSphereValue
+{
+    Fplane plane;
+    Fsphere sphere;
+};
+
+// Only the parser-owned values consumed by the traversal are retained.
+struct R4PreparedPortalGraph
+{
+    bool qualified = false;
+    std::vector<R4VisualNode> visualNodes;
+    R4LevelPortalMetadata portalMetadata;
+    std::vector<R4PortalPlaneSphereValue> portalPlaneSpheres;
+};
+
+struct R4PortalGenerationCache
+{
+    u64 generation = 0;
+    bool qualified = false;
+    std::string unavailableReason;
+    R4PreparedPortalGraph graph;
+    u32 outdoorSector = u32(-1);
+    std::unique_ptr<CDB::MODEL> portalModel;
+    double initializationCpuMs = 0.0;
+    std::string activeLevelReaderSha256;
+
+    R4PortalGenerationCache() = default;
+    R4PortalGenerationCache(const R4PortalGenerationCache&) = delete;
+    R4PortalGenerationCache& operator=(const R4PortalGenerationCache&) = delete;
+    R4PortalGenerationCache(R4PortalGenerationCache&&) = default;
+    R4PortalGenerationCache& operator=(R4PortalGenerationCache&&) = default;
+};
+
+struct R4PortalContextFrameInput
+{
+    u64 generation = 0;
+    u32 frameID = 0;
+    Fvector currentEye;
+    Fvector savedEye;
+    Fmatrix fullTransform;
+    float viewportNear = 0.f;
+    float ssaDiscard = 0.f;
+    float ssaLodA = 0.f;
+    float ssaLodB = 0.f;
+    bool drawPortals = false;
+};
+
+struct R4PortalContextFrameOutput
+{
+    u64 generation = 0;
+    u32 frameID = 0;
+    bool valid = false;
+    u32 startSector = u32(-1);
+    std::string unavailableReason;
+    double initializationCpuMs = 0.0;
+    double frameCpuMs = 0.0;
+    R4PortalGraphResult graph; // owns all reached CFrustum values
+};
+
+// Reuses actual CFrustum/ClipPoly traversal math with the generation's already
+// qualified CPortal planes/spheres; it does not call CPortal::Setup.
+bool ObserveR4PreparedPortalGraph(const R4PreparedPortalGraph& prepared,
+    const R4PortalGraphInputs& inputs, R4PortalGraphResult& output);
+
+// Initializes atomically from one parser result. Every portal/root/owner relation
+// is validated here, and CPortal::Setup runs exactly once per portal/generation.
+bool BuildR4PortalGenerationCache(const R4LevelGeometry& parsed, u64 generation,
+                                  R4PortalGenerationCache& output);
+
+// Mirrors CRender::detectLastSector. staticCform is borrowed for the call only;
+// no CDB::RESULT, CDB::TRI, CPortal, CSector, or parser pointer is retained.
+bool ResolveR4DetectLastSector(const R4PortalGenerationCache& cache,
+    const Fvector& eye, const CDB::MODEL* staticCform, u32& sectorId,
+    std::string& unavailableReason);
+
+// Source-math observer only. HOM is forced off (options=6). A stale generation,
+// unresolved sector, or walker uncertainty returns invalid with no partial owners.
+bool ObserveR4PortalGeneration(const R4PortalGenerationCache& cache,
+    const R4PortalContextFrameInput& input, const CDB::MODEL* staticCform,
+    R4PortalContextFrameOutput& output);
+} // namespace xray::metal
diff --git a/src/Layers/xrRenderMetal/R4PortalGenerationContext.cpp b/src/Layers/xrRenderMetal/R4PortalGenerationContext.cpp
new file mode 100644
--- /dev/null
+++ b/src/Layers/xrRenderMetal/R4PortalGenerationContext.cpp
@@ -0,0 +1,298 @@
+#include "stdafx.h"
+#include "R4PortalGenerationContext.h"
+#include "r__sector.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace xray::metal
+{
+namespace
+{
+constexpr u32 kNoPortal = u32(-1);
+constexpr float kDetectLastSectorRange = 1000.f;
+
+bool finiteVector(const Fvector& v)
+{
+    return std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z);
+}
+
+bool validRootBox(const R4VisualNode& node, Fbox& box)
+{
+    if (!node.boundsValid)
+        return false;
+    Fvector min, max;
+    min.set(node.box[0], node.box[1], node.box[2]);
+    max.set(node.box[3], node.box[4], node.box[5]);
+    if (!finiteVector(min) || !finiteVector(max) || min.x > max.x || min.y > max.y || min.z > max.z)
+        return false;
+    box.set(min, max);
+    const float volume = box.getvolume();
+    return std::isfinite(volume) && volume >= 0.f;
+}
+
+bool validPortalPolygon(const R4LevelPortalTopology& portal, std::vector<Fvector>& points)
+{
+    if (portal.vertices.size() < 3u || portal.vertices.size() > 6u)
+        return false;
+    points.clear();
+    for (const auto& v : portal.vertices)
+    {
+        if (!std::isfinite(v[0]) || !std::isfinite(v[1]) || !std::isfinite(v[2]))
+            return false;
+        Fvector p; p.set(v[0], v[1], v[2]); points.push_back(p);
+    }
+    Fvector normal; normal.mknormal_non_normalized(points[0], points[1], points[2]);
+    const float area = normal.magnitude();
+    if (!std::isfinite(area) || area <= EPS_S)
+        return false;
+    normal.div(area);
+    Fvector unitFanSum; unitFanSum.set(0.f, 0.f, 0.f);
+    for (std::size_t i = 2u; i < points.size(); ++i)
+    {
+        Fvector fan; fan.mknormal_non_normalized(points[0], points[i - 1u], points[i]);
+        const float fanArea = fan.magnitude();
+        if (!std::isfinite(fanArea) || fanArea <= EPS_S || normal.dotproduct(fan) <= EPS_S)
+            return false;
+        fan.div(fanArea); unitFanSum.add(fan);
+    }
+    if (!finiteVector(unitFanSum) || unitFanSum.magnitude() <= EPS_S)
+        return false;
+    for (const Fvector& p : points)
+    {
+        Fvector delta; delta.sub(p, points[0]);
+        if (_abs(normal.dotproduct(delta)) > EPS_L)
+            return false;
+    }
+    for (std::size_t i = 0; i < points.size(); ++i)
+    {
+        Fvector turn;
+        turn.mknormal_non_normalized(points[i], points[(i + 1u) % points.size()],
+            points[(i + 2u) % points.size()]);
+        if (!finiteVector(turn) || normal.dotproduct(turn) <= EPS_S)
+            return false;
+    }
+    return true;
+}
+
+bool buildPortalModel(const R4LevelPortalMetadata& topology, std::unique_ptr<CDB::MODEL>& model,
+    std::string& error)
+{
+    CDB::Collector collector;
+    u32 realTriangles = 0u;
+    for (const auto& portal : topology.portals)
+    {
+        std::vector<Fvector> points;
+        if (!validPortalPolygon(portal, points))
+        { error = "unqualified portal reached CDB collector"; return false; }
+        for (u32 j = 2u; j < points.size(); ++j)
+        {
+            collector.add_face_packed_D(points[0], points[j - 1u], points[j], portal.portalId);
+            ++realTriangles;
+        }
+    }
+    if (realTriangles == 0u)
+        return true; // No portal model; start-sector fallback may still use CFORM.
+    if (realTriangles == 1u)
+    {
+        // MODEL::build requires >=2 triangles and >=4 vertices. Keep the source
+        // loader's far-away sentinel idea, but never alias the synthetic hit to portal 0.
+        Fvector a, b, c;
+        a.set(-20000.f, -20000.f, -20000.f);
+        b.set(-20001.f, -20000.f, -20000.f);
+        c.set(-20000.f, -20001.f, -20000.f);
+        collector.add_face_packed_D(a, b, c, kNoPortal);
+    }
+    if (collector.getVS() < 4u || collector.getTS() < 2u ||
+        collector.getVS() > static_cast<std::size_t>(std::numeric_limits<int>::max()) ||
+        collector.getTS() > static_cast<std::size_t>(std::numeric_limits<int>::max()))
+    { error = "portal collector does not meet CDB::MODEL::build minimums"; return false; }
+
+    model.reset(new CDB::MODEL());
+    model->build(collector.getV(), static_cast<int>(collector.getVS()),
+        collector.getT(), static_cast<int>(collector.getTS()));
+    // MODEL::build/build_internal copy both arrays synchronously. memory()==0
+    // reports a failed/not-ready build before queries can touch a missing tree.
+    if (model->memory() == 0u)
+    { model.reset(); error = "CDB portal model build did not reach ready state"; return false; }
+    return true;
+}
+
+bool resolveDirection(const R4PortalGenerationCache& cache, const Fvector& eye,
+    const Fvector& direction, const CDB::MODEL* staticCform, u32& sectorId)
+{
+    if (cache.portalModel)
+    {
+        CDB::COLLIDER portalRay;
+        portalRay.ray_options(CDB::OPT_ONLYNEAREST);
+        portalRay.ray_query(cache.portalModel.get(), eye, direction, kDetectLastSectorRange);
+        if (portalRay.r_count() > 0)
+        {
+            const CDB::RESULT& hit = *portalRay.r_begin();
+            const u32 portalId = hit.dummy;
+            if (hit.id >= 0 && u32(hit.id) < cache.portalModel->get_tris_count() &&
+                portalId != kNoPortal && portalId < cache.graph.portalMetadata.portals.size())
+            {
+                const auto& source = cache.graph.portalMetadata.portals[portalId];
+                const auto& prepared = cache.graph.portalPlaneSpheres[portalId];
+                const u32 facing = prepared.plane.classify(eye) > 0.f ? source.frontSector : source.backSector;
+                if (facing < cache.graph.portalMetadata.sectors.size())
+                {
+                    const auto rootId = cache.graph.portalMetadata.sectors[facing].rootVisualId;
+                    Fbox root;
+                    if (rootId < cache.graph.visualNodes.size() &&
+                        validRootBox(cache.graph.visualNodes[rootId], root) && root.contains(eye))
+                    { sectorId = facing; return true; }
+                }
+            }
+            // Source checks only the nearest portal; an invalid/uncontained hit
+            // falls through to CFORM for this direction rather than trying later hits.
+        }
+    }
+
+    if (staticCform)
+    {
+        CDB::COLLIDER cformRay;
+        cformRay.ray_options(CDB::OPT_ONLYNEAREST);
+        cformRay.ray_query(staticCform, eye, direction, kDetectLastSectorRange);
+        if (cformRay.r_count() > 0)
+        {
+            // ray_query copies the hit TRI union (including its sector bits) into RESULT.
+            const CDB::RESULT& hit = *cformRay.r_begin();
+            const u32 sector = hit.sector;
+            if (hit.id >= 0 && u32(hit.id) < staticCform->get_tris_count() &&
+                sector < cache.graph.portalMetadata.sectors.size())
+            { sectorId = sector; return true; }
+        }
+    }
+    return false;
+}
+} // namespace
+
+bool BuildR4PortalGenerationCache(const R4LevelGeometry& parsed, const u64 generation,
+    R4PortalGenerationCache& output)
+{
+    output = R4PortalGenerationCache{}; // stale generations are destroyed before parsing new values.
+    R4PortalGenerationCache next;
+    next.generation = generation;
+    const auto& topology = parsed.portalMetadata;
+    if (!generation || !topology.available || topology.sectors.empty() ||
+        topology.visualOwnerSectors.size() != parsed.visualNodes.size())
+    { next.unavailableReason = "portal metadata, generation, or owner table unavailable"; output = std::move(next); return false; }
+
+    next.graph.visualNodes = parsed.visualNodes;
+    next.graph.portalMetadata = topology;
+    next.graph.portalPlaneSpheres.resize(topology.portals.size());
+    float largestVolume = 0.f;
+    for (u32 sid = 0u; sid < topology.sectors.size(); ++sid)
+    {
+        const auto& sector = topology.sectors[sid];
+        if (sector.sectorId != sid || sector.rootVisualId >= parsed.visualNodes.size())
+        { next.unavailableReason = "sector IDs or root visual reference are invalid"; output = std::move(next); return false; }
+        Fbox root;
+        if (!validRootBox(parsed.visualNodes[sector.rootVisualId], root))
+        { next.unavailableReason = "sector root has invalid or non-positive bounds"; output = std::move(next); return false; }
+        const float volume = root.getvolume();
+        if (volume > largestVolume)
+        { largestVolume = volume; next.outdoorSector = sid; }
+        for (std::size_t i = 0; i < sector.portalIds.size(); ++i)
+        {
+            const u16 pid = sector.portalIds[i];
+            if (pid >= topology.portals.size() ||
+                std::find(sector.portalIds.begin(), sector.portalIds.begin() + i, pid) != sector.portalIds.begin() + i ||
+                (topology.portals[pid].frontSector != sid && topology.portals[pid].backSector != sid))
+            { next.unavailableReason = "sector portal incidence is invalid or duplicated"; output = std::move(next); return false; }
+        }
+    }
+    if (next.outdoorSector == u32(-1))
+    { next.unavailableReason = "no valid largest-volume root visual"; output = std::move(next); return false; }
+
+    for (u32 pid = 0u; pid < topology.portals.size(); ++pid)
+    {
+        const auto& portalData = topology.portals[pid];
+        if (portalData.portalId != pid || portalData.frontSector >= topology.sectors.size() ||
+            portalData.backSector >= topology.sectors.size() || portalData.frontSector == portalData.backSector)
+        { next.unavailableReason = "portal IDs or endpoints are invalid"; output = std::move(next); return false; }
+        if (std::count(topology.sectors[portalData.frontSector].portalIds.begin(),
+                topology.sectors[portalData.frontSector].portalIds.end(), static_cast<u16>(pid)) != 1 ||
+            std::count(topology.sectors[portalData.backSector].portalIds.begin(),
+                topology.sectors[portalData.backSector].portalIds.end(), static_cast<u16>(pid)) != 1)
+        { next.unavailableReason = "portal endpoint adjacency is incomplete"; output = std::move(next); return false; }
+        std::vector<Fvector> points;
+        if (!validPortalPolygon(portalData, points))
+        { next.unavailableReason = "portal polygon is not finite, planar, convex and nondegenerate"; output = std::move(next); return false; }
+        CPortal portal; portal.Setup(points.data(), static_cast<int>(points.size()), nullptr, nullptr);
+        if (!finiteVector(portal.P.n) || !std::isfinite(portal.P.d) || portal.P.n.magnitude() <= EPS_S ||
+            !finiteVector(portal.S.P) || !std::isfinite(portal.S.R) || portal.S.R < 0.f)
+        { next.unavailableReason = "CPortal::Setup returned invalid cached values"; output = std::move(next); return false; }
+        next.graph.portalPlaneSpheres[pid] = {portal.P, portal.S};
+    }
+    for (const auto& owners : topology.visualOwnerSectors)
+        for (std::size_t i = 0; i < owners.size(); ++i)
+            if (owners[i] >= topology.sectors.size() ||
+                std::find(owners.begin(), owners.begin() + i, owners[i]) != owners.begin() + i)
+            { next.unavailableReason = "visual owner sector is out of range or duplicated"; output = std::move(next); return false; }
+
+    if (!buildPortalModel(topology, next.portalModel, next.unavailableReason))
+    { output = std::move(next); return false; }
+    next.graph.qualified = true;
+    next.qualified = true;
+    output = std::move(next);
+    return true;
+}
+
+bool ResolveR4DetectLastSector(const R4PortalGenerationCache& cache, const Fvector& eye,
+    const CDB::MODEL* staticCform, u32& sectorId, std::string& unavailableReason)
+{
+    sectorId = u32(-1);
+    unavailableReason.clear();
+    if (!cache.qualified || !finiteVector(eye))
+    { unavailableReason = "invalid or unqualified generation/eye"; return false; }
+    if (cache.graph.portalMetadata.sectors.size() == 1u)
+    {
+        sectorId = cache.outdoorSector; // source shortcut returns pOutdoorSector.
+        return sectorId == 0u;
+    }
+    Fvector down, up; down.set(0.f, -1.f, 0.f); up.set(0.f, 1.f, 0.f);
+    if (resolveDirection(cache, eye, down, staticCform, sectorId)) return true;
+    if (resolveDirection(cache, eye, up, staticCform, sectorId)) return true;
+    unavailableReason = "detectLastSector found no accepted portal or static-CFORM sector";
+    return false;
+}
+
+bool ObserveR4PortalGeneration(const R4PortalGenerationCache& cache,
+    const R4PortalContextFrameInput& input, const CDB::MODEL* staticCform,
+    R4PortalContextFrameOutput& output)
+{
+    output = {};
+    output.generation = input.generation;
+    output.frameID = input.frameID;
+    output.graph.rawVisualVisible.assign(cache.graph.visualNodes.size(), 1u);
+    output.graph.ownerFrustumTests.assign(cache.graph.visualNodes.size(), 0u);
+    if (!cache.qualified || input.generation != cache.generation)
+    { output.unavailableReason = "stale or unqualified level generation"; return false; }
+    u32 startSector = u32(-1);
+    if (!ResolveR4DetectLastSector(cache, input.currentEye, staticCform, startSector,
+        output.unavailableReason))
+        return false;
+
+    R4PortalGraphInputs graphInput;
+    graphInput.captured = true;
+    graphInput.startSector = startSector;
+    graphInput.savedCameraEye = input.savedEye;
+    graphInput.graphEye = input.currentEye;
+    graphInput.fullTransform = input.fullTransform;
+    graphInput.viewportNear = input.viewportNear;
+    graphInput.ssaDiscard = input.ssaDiscard;
+    graphInput.ssaLodA = input.ssaLodA;
+    graphInput.ssaLodB = input.ssaLodB;
+    graphInput.options = 0x6u; // source showHOM bit is deliberately off.
+    graphInput.drawPortals = input.drawPortals;
+    if (!ObserveR4PreparedPortalGraph(cache.graph, graphInput, output.graph) || !output.graph.valid)
+    { output.unavailableReason = output.graph.unavailableReason; output.graph.reached.clear(); return false; }
+    output.valid = true;
+    output.startSector = startSector;
+    return true;
+}
+} // namespace xray::metal
diff --git a/src/Layers/xrRenderMetal/R4PortalGraphPreparedObserver.cpp b/src/Layers/xrRenderMetal/R4PortalGraphPreparedObserver.cpp
new file mode 100644
--- /dev/null
+++ b/src/Layers/xrRenderMetal/R4PortalGraphPreparedObserver.cpp
@@ -0,0 +1,190 @@
+#include "stdafx.h"
+#include "R4PortalGenerationContext.h"
+
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <unordered_set>
+#include <utility>
+
+namespace xray::metal
+{
+namespace
+{
+constexpr u32 kVqHom = 1u;
+constexpr u32 kVqSsa = 2u;
+constexpr u32 kVqFade = 4u;
+constexpr u32 kMaxDepth = 128u;
+
+bool finiteVector(const Fvector& value)
+{
+	return std::isfinite(value.x) && std::isfinite(value.y) && std::isfinite(value.z);
+}
+
+bool validPolygon(const R4LevelPortalTopology& portal, std::vector<Fvector>& points)
+{
+	if (portal.vertices.size() < 3u || portal.vertices.size() > 6u) return false;
+	points.clear();
+	for (const auto& source : portal.vertices)
+	{
+		if (!std::isfinite(source[0]) || !std::isfinite(source[1]) || !std::isfinite(source[2])) return false;
+		Fvector point; point.set(source[0], source[1], source[2]);
+		points.push_back(point);
+	}
+	Fvector normal; normal.mknormal_non_normalized(points[0], points[1], points[2]);
+	const float firstArea = normal.magnitude();
+	if (!std::isfinite(firstArea) || firstArea <= EPS_S) return false;
+	normal.div(firstArea);
+	Fvector unitFanSum; unitFanSum.set(0.f, 0.f, 0.f);
+	for (std::size_t i = 2u; i < points.size(); ++i)
+	{
+		Fvector fan; fan.mknormal_non_normalized(points[0], points[i - 1u], points[i]);
+		const float area = fan.magnitude();
+		if (!std::isfinite(area) || area <= EPS_S || normal.dotproduct(fan) <= EPS_S) return false;
+		fan.div(area); unitFanSum.add(fan);
+	}
+	if (!finiteVector(unitFanSum) || unitFanSum.magnitude() <= EPS_S) return false;
+	for (const Fvector& point : points)
+	{
+		Fvector delta; delta.sub(point, points[0]);
+		if (_abs(normal.dotproduct(delta)) > EPS_L) return false;
+	}
+	for (std::size_t i = 0u; i < points.size(); ++i)
+	{
+		Fvector turn;
+		turn.mknormal_non_normalized(points[i], points[(i + 1u) % points.size()], points[(i + 2u) % points.size()]);
+		if (!finiteVector(turn) || normal.dotproduct(turn) <= EPS_S) return false;
+	}
+	return true;
+}
+
+bool validFrustum(const CFrustum& frustum)
+{
+	if (frustum.p_count < 3 || frustum.p_count > FRUSTUM_MAXPLANES) return false;
+	for (int i = 0; i < frustum.p_count; ++i)
+	{
+		const auto& plane = frustum.planes[i];
+		if (!finiteVector(plane.n) || !std::isfinite(plane.d) || plane.n.magnitude() <= EPS_S) return false;
+	}
+	return true;
+}
+} // namespace
+
+bool ObserveR4PreparedPortalGraph(const R4PreparedPortalGraph& geometry, const R4PortalGraphInputs& in,
+	R4PortalGraphResult& out)
+{
+	out = {};
+	out.rawVisualVisible.assign(geometry.visualNodes.size(), 1u);
+	out.ownerFrustumTests.assign(geometry.visualNodes.size(), 0u);
+	const auto failOpen = [&](std::string reason) {
+		out.valid = false; out.unavailableReason = std::move(reason); out.reached.clear();
+		std::fill(out.rawVisualVisible.begin(), out.rawVisualVisible.end(), 1u);
+		return false;
+	};
+	const auto& topology = geometry.portalMetadata;
+	const auto& portals = geometry.portalPlaneSpheres;
+	if (!geometry.qualified || !topology.available || topology.sectors.empty() ||
+		topology.portals.size() != portals.size() || in.startSector >= topology.sectors.size())
+		return failOpen("cached portal generation or starting sector is invalid");
+	if (!in.captured || (in.options & kVqHom) || !finiteVector(in.savedCameraEye) || !finiteVector(in.graphEye) ||
+		!_valid(in.fullTransform) || !std::isfinite(in.viewportNear) || in.viewportNear <= 0.f ||
+		!std::isfinite(in.ssaDiscard) || in.ssaDiscard < 0.f || !std::isfinite(in.ssaLodA) ||
+		in.ssaLodA < 0.f || !std::isfinite(in.ssaLodB) || in.ssaLodB < 0.f || in.ssaLodB > in.ssaLodA)
+		return failOpen("invalid view, near plane, SSA thresholds, or HOM-enabled options");
+
+	out.reached.resize(topology.sectors.size());
+	std::vector<std::unordered_set<u16>> visited(topology.sectors.size());
+	Fmatrix rootTransform = in.fullTransform;
+	CFrustum base; base.CreateFromMatrix(rootTransform, FRUSTUM_P_LRTB | FRUSTUM_P_FAR);
+	if (!validFrustum(base)) return failOpen("primary CFrustum::CreateFromMatrix returned invalid planes");
+	std::function<bool(u32, const CFrustum&, u32)> visit;
+	visit = [&](const u32 sid, const CFrustum& frustum, const u32 depth) {
+		if (depth > kMaxDepth) { out.unavailableReason = "portal graph recursion depth exceeded"; return false; }
+		out.reached[sid].sectorId = sid; out.reached[sid].values.push_back(frustum);
+		for (const u16 pid : topology.sectors[sid].portalIds)
+		{
+			++out.portalChecks;
+			if (visited[sid].find(pid) != visited[sid].end()) continue;
+			const auto& source = topology.portals[pid]; const auto& portal = portals[pid];
+			Fvector center = portal.sphere.P; float radius = portal.sphere.R;
+			if (!frustum.testSphere_dirty(center, radius)) continue;
+			u32 target = u32(-1);
+			Fvector nearDelta; nearDelta.sub(portal.sphere.P, in.savedCameraEye);
+			if (nearDelta.magnitude() < portal.sphere.R && _abs(portal.plane.classify(in.savedCameraEye)) <= in.viewportNear + EPS_L)
+				target = sid == source.frontSector ? source.backSector : source.frontSector;
+			else
+				target = portal.plane.classify(in.graphEye) > 0.f ? source.backSector : source.frontSector;
+			if (target == sid || target == in.startSector || target >= topology.sectors.size()) continue;
+
+			// Preserve the exact source expression: ((options & VQ_FADE) | VQ_SSA) && rsDrawPortals.
+			if (!(((in.options & kVqFade) | kVqSsa) && in.drawPortals) && (in.options & kVqSsa))
+			{
+				Fvector dir; dir.sub(portal.sphere.P, in.graphEye);
+				const float distSq = dir.square_magnitude();
+				if (!std::isfinite(distSq) || distSq <= 0.f) { out.unavailableReason = "invalid SSA distance"; return false; }
+				float ssa = portal.sphere.R * portal.sphere.R / distSq;
+				dir.div(_sqrt(distSq)); ssa *= _abs(portal.plane.n.dotproduct(dir));
+				if (!std::isfinite(ssa)) { out.unavailableReason = "nonfinite portal SSA"; return false; }
+				if (ssa < in.ssaDiscard) continue;
+				if ((in.options & kVqFade) && ssa < in.ssaLodB) continue;
+			}
+
+			sPoly sourcePoly, clippedPoly;
+			std::vector<Fvector> points;
+			for (const auto& v : source.vertices) { Fvector p; p.set(v[0], v[1], v[2]); points.push_back(p); }
+			sourcePoly.assign(points.data(), points.size());
+			sPoly* clipped = frustum.ClipPoly(sourcePoly, clippedPoly);
+			if (!clipped) continue;
+			CFrustum next;
+			if (clipped->size() > 6u) { next = frustum; ++out.uncertainWideClipPasses; }
+			else
+			{
+				R4LevelPortalTopology clippedRecord; std::vector<Fvector> clippedPoints;
+				for (const Fvector& p : *clipped) clippedRecord.vertices.push_back({p.x, p.y, p.z});
+				if (!validPolygon(clippedRecord, clippedPoints))
+					{ out.unavailableReason = "clipped portal polygon is degenerate or nonconvex"; return false; }
+				for (std::size_t i = 0u; i < clippedPoints.size(); ++i)
+				{
+					Fvector side; side.mknormal_non_normalized(in.graphEye, clippedPoints[i],
+						clippedPoints[(i + 1u) % clippedPoints.size()]);
+					if (!finiteVector(side) || side.magnitude() <= EPS_S)
+						{ out.unavailableReason = "portal-eye side plane is degenerate"; return false; }
+				}
+				Fvector unusedEye = in.graphEye, graphBase = in.graphEye;
+				Fmatrix full = in.fullTransform;
+				next.CreateFromPortal(clipped, unusedEye, graphBase, full);
+				if (!validFrustum(next)) { out.unavailableReason = "portal CFrustum::CreateFromPortal returned invalid planes"; return false; }
+			}
+			visited[sid].insert(pid); ++out.portalRecursions;
+			if (!visit(target, next, depth + 1u)) return false;
+		}
+		return true;
+	};
+	if (!visit(in.startSector, base, 0u)) return failOpen(out.unavailableReason.c_str());
+
+	std::fill(out.rawVisualVisible.begin(), out.rawVisualVisible.end(), 1u);
+	for (std::size_t vid = 0u; vid < geometry.visualNodes.size(); ++vid)
+	{
+		const auto& node = geometry.visualNodes[vid];
+		if (!node.boundsValid || vid >= topology.visualOwnerSectors.size()) continue;
+		const auto& owners = topology.visualOwnerSectors[vid];
+		if (owners.empty()) continue; // unknown ownership remains visible
+		out.rawVisualVisible[vid] = 0u;
+		Fvector center; center.set(node.sphere[0], node.sphere[1], node.sphere[2]);
+		for (const u32 sid : owners)
+		{
+			if (sid >= out.reached.size()) return failOpen("visual owner sector is out of range");
+			for (const CFrustum& frustum : out.reached[sid].values)
+			{
+				++out.ownerFrustumTests[vid];
+				u32 mask = frustum.getMask();
+				if (frustum.testSAABB(center, node.sphere[3], node.box.data(), mask) != fcvNone)
+					out.rawVisualVisible[vid] = 1u;
+			}
+		}
+	}
+	out.valid = true;
+	out.unavailableReason.clear();
+	return true;
+}
+} // namespace xray::metal
