+	const Chunk* boundsVisualList = findOptionalUniqueChunk(topChunks, kLevelVisualsChunk, duplicateChunk);
+	if (!boundsVisualList || duplicateChunk) { error = "visual fixture chunk missing"; return false; }
+	std::vector<Chunk> boundsVisualItems;
+	if (!scanChunks(unorderedRootBounds, boundsVisualList->dataBegin, boundsVisualList->dataEnd, boundsVisualItems, error)) return false;
+	const Chunk* rootItem = nullptr;
+	for (const Chunk& item : boundsVisualItems) if (item.id == 1u) rootItem = &item;
+	if (!rootItem) { error = "root visual fixture missing"; return false; }
+	std::vector<Chunk> rootOgfChunks;
+	if (!scanChunks(unorderedRootBounds, rootItem->dataBegin, rootItem->dataEnd, rootOgfChunks, error)) return false;
+	const Chunk* rootHeader = nullptr;
+	for (const Chunk& item : rootOgfChunks) if (item.id == kOgfHeaderChunk) rootHeader = &item;
+	if (!rootHeader) { error = "root OGF header fixture missing"; return false; }
+	const float invertedMaxX = -2.0f;
+	std::memcpy(unorderedRootBounds.data() + rootHeader->dataBegin + 4u + 3u * sizeof(float),
+		&invertedMaxX, sizeof(invertedMaxX));
+	if (!ParseR4LevelGeometry(geometryBytes, unorderedRootBounds, parsed, error) || parsed.portalMetadata.available ||
+		parsed.visuals.size() != 1u || !parsed.visuals.front().valid || parsed.visualNodes[1].boundsValid)
+	{
+		if (error.empty()) error = "invalid optional root bounds affected geometry admission";
+		return false;
+	}
+	std::vector<std::uint8_t> cyclicTopology = topologyLevelBytes;
+	topChunks.clear();
+	if (!scanChunks(cyclicTopology, 0u, cyclicTopology.size(), topChunks, error)) return false;
+	duplicateChunk = false;
+	const Chunk* visualList = findOptionalUniqueChunk(topChunks, kLevelVisualsChunk, duplicateChunk);
+	if (!visualList || duplicateChunk) { error = "visual fixture chunk missing"; return false; }
+	std::vector<Chunk> visualItems;
+	if (!scanChunks(cyclicTopology, visualList->dataBegin, visualList->dataEnd, visualItems, error)) return false;
+	const Chunk* hierarchyChunk = nullptr;
+	for (const Chunk& item : visualItems) if (item.id == 1u) hierarchyChunk = &item;
+	if (!hierarchyChunk) { error = "hierarchy fixture missing"; return false; }
+	std::vector<Chunk> hierarchyChunks;
+	if (!scanChunks(cyclicTopology, hierarchyChunk->dataBegin, hierarchyChunk->dataEnd, hierarchyChunks, error)) return false;
+	const Chunk* hierarchyLinks = nullptr;
+	for (const Chunk& item : hierarchyChunks) if (item.id == kOgfLinkedChildrenChunk) hierarchyLinks = &item;
+	if (!hierarchyLinks || hierarchyLinks->dataEnd - hierarchyLinks->dataBegin != 8u)
+		{ error = "hierarchy link fixture malformed"; return false; }
+	cyclicTopology[hierarchyLinks->dataBegin + 4u] = 1u;
+	if (!ParseR4LevelGeometry(geometryBytes, cyclicTopology, parsed, error) || parsed.portalMetadata.available ||
+		parsed.visuals.size() != 1u || !parsed.visuals.front().valid)
+	{
+		if (error.empty()) error = "optional topology cycle affected geometry admission";
+		return false;
+	}
+	error.clear();
 
 	geometryBytes.back() = 3u;
 	if (!ParseR4LevelGeometry(geometryBytes, levelBytes, parsed, error))
