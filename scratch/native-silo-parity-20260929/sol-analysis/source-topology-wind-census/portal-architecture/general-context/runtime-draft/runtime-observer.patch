+#pragma once
+
+#include "R4LevelGeometry.h"
+#include "xrCDB/Frustum.h"
+
+namespace xray::metal
+{
+struct R4PortalGraphInputs
+{
+	bool captured = false; // caller sets only after all frame-bound fields are copied coherently
+	u32 startSector = u32(-1); // externally validated; CFORM detection is outside this helper
+	Fvector savedCameraEye;
+	Fvector graphEye;
+	Fmatrix fullTransform;
+	float viewportNear = 0.f;
+	float ssaDiscard = 0.f;
+	float ssaLodA = 0.f;
+	float ssaLodB = 0.f;
+	u32 options = 0; // source CDSGraphManager bits; VQ_HOM must be clear
+	bool drawPortals = false;
+};
+
+struct R4PortalSectorFrustums
+{
+	u32 sectorId = 0;
+	std::vector<CFrustum> values;
+};
+
+struct R4PortalGraphResult
+{
+	bool valid = false;
+	std::string unavailableReason;
+	std::vector<R4PortalSectorFrustums> reached;
+	std::vector<std::uint8_t> rawVisualVisible; // raw OGF sphere+AABB test; not ancestor/HOM/shipping visibility
+	std::vector<u32> ownerFrustumTests;
+	u32 portalChecks = 0;
+	u32 portalRecursions = 0;
+	u32 uncertainWideClipPasses = 0;
+};
+
+// Pure observer only. Invalid input means every visual is returned visible.
+bool ObserveR4PortalGraph(const R4LevelGeometry& geometry, const R4PortalGraphInputs& inputs,
+	R4PortalGraphResult& result);
+} // namespace xray::metal
