+struct TopologyCensusFrustum
+{
+	u32 mask = 0;
+	std::vector<std::array<float, 4>> planes;
+};
+
+struct TopologyCensusSector
+{
+	int sectorIndex = -1;
+	int rootVisualIndex = -1;
+	std::vector<TopologyCensusFrustum> frustums;
+};
+
+bool topologyFinite(const float value)
+{
+	return std::isfinite(value);
+}
+
+bool topologyMatrixValid(const Fmatrix& matrix)
+{
+	bool anyNonZero = false;
+	for (int row = 0; row < 4; ++row)
+	{
+		for (int column = 0; column < 4; ++column)
+		{
+			const float value = matrix.m[row][column];
+			if (!topologyFinite(value))
+				return false;
+			anyNonZero = anyNonZero || value != 0.0f;
+		}
+	}
+	return anyNonZero;
+}
+
+bool topologyFloatHasBits(const float value, const u32 expectedBits)
+{
+	u32 bits = 0;
+	std::memcpy(&bits, &value, sizeof(bits));
+	return bits == expectedBits;
+}
+
+u32 topologyFloatBits(const float value)
+{
+	u32 bits = 0;
+	std::memcpy(&bits, &value, sizeof(bits));
+	return bits;
+}
+
+bool topologySameVectorBits(const Fvector& left, const Fvector& right)
+{
+	return topologyFloatBits(left.x) == topologyFloatBits(right.x) &&
+		topologyFloatBits(left.y) == topologyFloatBits(right.y) &&
+		topologyFloatBits(left.z) == topologyFloatBits(right.z);
+}
+
+bool topologySameMatrixBits(const Fmatrix& left, const Fmatrix& right)
+{
+	for (int row = 0; row < 4; ++row)
+	{
+		for (int column = 0; column < 4; ++column)
+		{
+			u32 leftBits = 0;
+			u32 rightBits = 0;
+			std::memcpy(&leftBits, &left.m[row][column], sizeof(leftBits));
+			std::memcpy(&rightBits, &right.m[row][column], sizeof(rightBits));
+			if (leftBits != rightBits)
+				return false;
+		}
+	}
+	return true;
+}
+
+void topologyAddReason(std::string& reason, const char* item)
+{
+	if (!reason.empty())
+		reason += ";";
+	reason += item;
+}
+
+void topologyJsonString(std::ostream& out, const char* value)
+{
+	out << '"';
+	if (value)
+	{
+		for (const unsigned char ch : std::string(value))
+		{
+			if (ch == '"' || ch == '\\')
+				out << '\\' << char(ch);
+			else if (ch < 0x20u)
+				out << "\\u00" << std::hex << std::setw(2) << std::setfill('0') << unsigned(ch)
+					<< std::dec << std::setfill(' ');
+			else
+				out << char(ch);
+		}
+	}
+	out << '"';
+}
+
+void topologyJsonFloat(std::ostream& out, const float value)
+{
+	if (topologyFinite(value))
+		out << std::setprecision(std::numeric_limits<float>::max_digits10) << value;
+	else
+		out << "null";
+}
+
+void topologyJsonVector3(std::ostream& out, const Fvector& value)
+{
+	out << '[';
+	topologyJsonFloat(out, value.x); out << ',';
+	topologyJsonFloat(out, value.y); out << ',';
+	topologyJsonFloat(out, value.z);
+	out << ']';
+}
+
+void topologyJsonMatrix(std::ostream& out, const Fmatrix& value)
+{
+	out << '[';
+	for (int row = 0, index = 0; row < 4; ++row)
+	{
+		for (int column = 0; column < 4; ++column, ++index)
+		{
+			if (index)
+				out << ',';
+			topologyJsonFloat(out, value.m[row][column]);
+		}
+	}
+	out << ']';
+}
