+constexpr std::size_t kFixedPortalRoiVisualCount = 4086u;
+
+struct FixedPortalRoiFixture
+{
+    std::array<std::uint32_t, 16> viewBits{};
+    std::array<std::uint32_t, 16> projectionBits{};
+    std::array<std::uint32_t, 3> eyeBits{};
+    // true means LeafBump; false means TrunkFlat.
+    std::unordered_map<std::uint32_t, bool> visualMaterials;
+};
+
+std::vector<std::string> splitPortalRoiCsvRow(const std::string& row)
+{
+    std::vector<std::string> fields;
+    std::size_t begin = 0;
+    for (;;)
+    {
+        const std::size_t comma = row.find(',', begin);
+        fields.emplace_back(row.substr(begin,
+            comma == std::string::npos ? comma : comma - begin));
+        if (comma == std::string::npos)
+            break;
+        begin = comma + 1u;
+    }
+    return fields;
+}
+
+bool parsePortalRoiHexWord(const std::string& value, std::uint32_t& result)
+{
+    if (value.size() != 8u)
+        return false;
+    result = 0u;
+    for (const char digit : value)
+    {
+        std::uint32_t nibble = 0u;
+        if (digit >= '0' && digit <= '9') nibble = std::uint32_t(digit - '0');
+        else if (digit >= 'a' && digit <= 'f') nibble = std::uint32_t(digit - 'a' + 10);
+        else if (digit >= 'A' && digit <= 'F') nibble = std::uint32_t(digit - 'A' + 10);
+        else return false;
+        result = (result << 4u) | nibble;
+    }
+    return true;
+}
+
+bool parsePortalRoiId(const std::string& value, std::uint32_t& result)
+{
+    if (value.empty())
+        return false;
+    std::uint64_t parsed = 0u;
+    for (const char digit : value)
+    {
+        if (digit < '0' || digit > '9')
+            return false;
+        parsed = parsed * 10u + std::uint32_t(digit - '0');
+        if (parsed > std::numeric_limits<std::uint32_t>::max())
+            return false;
+    }
+    result = std::uint32_t(parsed);
+    return true;
+}
+
+template <std::size_t N>
+bool parsePortalRoiBitsRow(const std::vector<std::string>& fields, const char* key,
+    std::array<std::uint32_t, N>& output)
+{
+    if (fields.size() != N + 1u || fields[0] != key)
+        return false;
+    for (std::size_t i = 0; i < N; ++i)
+        if (!parsePortalRoiHexWord(fields[i + 1u], output[i]))
+            return false;
+    return true;
+}
+
+template <std::size_t N>
+bool portalRoiBitsFinite(const std::array<std::uint32_t, N>& bits)
+{
+    for (const std::uint32_t word : bits)
+    {
+        float value = 0.0f;
+        std::memcpy(&value, &word, sizeof(value));
+        if (!std::isfinite(value))
+            return false;
+    }
+    return true;
+}
+
+bool readFixedPortalRoiFixture(const std::filesystem::path& path,
+    FixedPortalRoiFixture& fixture, std::string& error)
+{
+    std::ifstream input(path, std::ios::binary);
+    if (!input)
+    {
+        error = "fixed-ID portal fixture is unavailable";
+        return false;
+    }
+    std::string row;
+    if (!std::getline(input, row) || row != "schema,main-flora-portal-upper-bound-fixed-id/v1")
+    {
+        error = "fixed-ID portal fixture schema is invalid";
+        return false;
+    }
+    if (!std::getline(input, row) || row != "visual_id_count,4086")
+    {
+        error = "fixed-ID portal fixture must contain exactly 4086 IDs";
+        return false;
+    }
+    if (!std::getline(input, row) ||
+        !parsePortalRoiBitsRow(splitPortalRoiCsvRow(row), "view_bits", fixture.viewBits) ||
+        !std::getline(input, row) ||
+        !parsePortalRoiBitsRow(splitPortalRoiCsvRow(row), "projection_bits", fixture.projectionBits) ||
+        !std::getline(input, row) ||
+        !parsePortalRoiBitsRow(splitPortalRoiCsvRow(row), "eye_bits", fixture.eyeBits) ||
+        !std::getline(input, row) || row != "visual_id,material")
+    {
+        error = "fixed-ID portal fixture camera header is malformed";
+        return false;
+    }
+    if (!portalRoiBitsFinite(fixture.viewBits) || !portalRoiBitsFinite(fixture.projectionBits) ||
+        !portalRoiBitsFinite(fixture.eyeBits))
+    {
+        error = "fixed-ID portal fixture camera contains non-finite float bits";
+        return false;
+    }
+    while (std::getline(input, row))
+    {
+        const std::vector<std::string> fields = splitPortalRoiCsvRow(row);
+        std::uint32_t visualId = 0u;
+        const bool leaf = fields.size() == 2u && fields[1] == "leaf";
+        const bool trunk = fields.size() == 2u && fields[1] == "trunk";
+        if (fields.size() != 2u || (!leaf && !trunk) ||
+            !parsePortalRoiId(fields[0], visualId) ||
+            !fixture.visualMaterials.emplace(visualId, leaf).second)
+        {
+            error = "fixed-ID portal fixture contains an invalid material, ID, or duplicate";
+            return false;
+        }
+    }
+    if (!input.eof() || fixture.visualMaterials.size() != kFixedPortalRoiVisualCount)
+    {
+        error = "fixed-ID portal fixture read failed or its ID count changed";
+        return false;
+    }
+    return true;
+}
+
+template <std::size_t N>
+bool portalRoiFloatsMatch(const std::array<float, N>& values,
+    const std::array<std::uint32_t, N>& bits)
+{
+    for (std::size_t i = 0; i < N; ++i)
+    {
+        std::uint32_t actual = 0u;
+        std::memcpy(&actual, &values[i], sizeof(actual));
+        if (actual != bits[i])
+            return false;
+    }
+    return true;
+}
+
+bool fixedPortalRoiCameraMatches(const FixedPortalRoiFixture& fixture,
+    const R4FloraViewState& view)
+{
+    return view.valid && portalRoiFloatsMatch(view.view, fixture.viewBits) &&
+        portalRoiFloatsMatch(view.projection, fixture.projectionBits) &&
+        portalRoiFloatsMatch(view.eye, fixture.eyeBits);
 }
 
