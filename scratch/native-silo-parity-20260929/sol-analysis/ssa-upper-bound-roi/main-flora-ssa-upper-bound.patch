+// Diagnostic frame-700 camera only. These are the accepted view float32 bits
+// from the exact-ID observer; a moving/changed camera must never reuse its IDs.
+constexpr std::array<std::uint32_t, 16> kSsaRoiViewBits = {
+    0x3f800000,0x00000000,0x80000000,0x00000000,
+    0x80000000,0x3f800000,0x00000000,0x00000000,
+    0x00000000,0x00000000,0x3f800000,0x00000000,
+    0x435d1523,0x41924768,0x43282e9a,0x3f800000};
+constexpr std::array<std::uint32_t, 16> kSsaRoiProjectionBits = {
+    0x3f3eae39,0x00000000,0x00000000,0x00000000,
+    0x00000000,0x3f988b61,0x00000000,0x00000000,
+    0x00000000,0x00000000,0x3f800a1e,0x3f800000,
+    0x00000000,0x00000000,0xbe4cdcfd,0x00000000};
+constexpr std::array<std::uint32_t, 3> kSsaRoiEyeBits = {
+    0xc35d1523,0xc1924768,0xc3282e9a};
+
+bool exactSsaRoiView(const R4FloraViewState& view)
+{
+    return std::memcmp(view.view.data(), kSsaRoiViewBits.data(), sizeof(view.view)) == 0 &&
+        std::memcmp(view.projection.data(), kSsaRoiProjectionBits.data(), sizeof(view.projection)) == 0 &&
+        std::memcmp(view.eye.data(), kSsaRoiEyeBits.data(), sizeof(view.eye)) == 0;
+}
+
+bool parseSsaRoiIds(const std::string& contents,
+    std::vector<std::pair<std::uint32_t, bool>>& ids)
+{
+    std::istringstream input(contents);
+    std::string line;
+    const auto expect = [&](const char* expected) {
+        return bool(std::getline(input, line)) && line == expected;
+    };
+    if (!expect("schema,main-flora-ssa-upper-bound/v1") ||
+        !expect("source_level_sha256,1800a451d0bba9af1da69fae8683b36b6e6346709c0d6b9bf14385f4a48d19f7") ||
+        !expect("capture_sha256,dca66b5c94dffae895bc33ba77a4cdc57881cce7c5252b07ba823b2dd6bdcdbc") ||
+        !expect("frame,700") || !expect("count,1199") ||
+        !expect("visual_id,material"))
+        return false;
+    ids.clear();
+    ids.reserve(1199u);
+    std::uint32_t previous = 0;
+    for (std::size_t row = 0; row < 1199u; ++row)
+    {
+        if (!std::getline(input, line)) return false;
+        const std::size_t comma = line.find(',');
+        if (comma == std::string::npos || comma == 0u) return false;
+        std::uint64_t parsed = 0;
+        for (std::size_t i = 0; i < comma; ++i)
+        {
+            if (line[i] < '0' || line[i] > '9') return false;
+            const std::uint64_t digit = std::uint64_t(line[i] - '0');
+            if (parsed > (std::numeric_limits<std::uint32_t>::max() - digit) / 10u)
+                return false;
+            parsed = parsed * 10u + digit;
+        }
+        if (parsed <= previous ||
+            (line.substr(comma + 1u) != "leaf" && line.substr(comma + 1u) != "trunk"))
+            return false;
+        previous = static_cast<std::uint32_t>(parsed);
+        ids.emplace_back(previous, line.substr(comma + 1u) == "leaf");
+    }
+    return !std::getline(input, line) && input.eof();
+}
 
 struct Matrix4 { float elements[16]{}; };
 
