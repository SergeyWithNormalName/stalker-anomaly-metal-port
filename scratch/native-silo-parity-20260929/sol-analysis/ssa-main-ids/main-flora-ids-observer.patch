+struct MainFloraIdCaptureConfig
+{
+    std::filesystem::path directory;
+    std::uint32_t frame = 0;
+    bool enabled = false;
+};
+
+const MainFloraIdCaptureConfig& mainFloraIdCaptureConfig()
+{
+    static const MainFloraIdCaptureConfig config = [] {
+        MainFloraIdCaptureConfig result;
+        const char* directory = std::getenv("XRAY_METAL_MAIN_FLORA_IDS_DIR");
+        const char* frame = std::getenv("XRAY_METAL_MAIN_FLORA_IDS_FRAME");
+        if (!directory || !*directory || !frame || !*frame)
+            return result;
+        char* end = nullptr;
+        const unsigned long parsed = std::strtoul(frame, &end, 10);
+        if (*end != '\0' || parsed < 300ul ||
+            parsed > std::numeric_limits<std::uint32_t>::max())
+        {
+            std::fprintf(stderr, "METAL_MAIN_FLORA_IDS status=invalid_frame value=%s\n", frame);
+            return result;
+        }
+        result.directory = directory;
+        result.frame = static_cast<std::uint32_t>(parsed);
+        result.enabled = true;
+        return result;
+    }();
+    return config;
+}
+
+std::uint32_t floatBits(const float value)
+{
+    std::uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+template<std::size_t N>
+void writeFloatBits(std::ofstream& output, const char* key,
+    const std::array<float, N>& values)
+{
+    output << key;
+    for (const float value : values)
+    {
+        char bits[9];
+        std::snprintf(bits, sizeof(bits), "%08x", unsigned(floatBits(value)));
+        output << ',' << bits;
+    }
+    output << '\n';
+}
+
+struct CapturedMainFloraDraw
+{
+    std::uint32_t visualId = 0;
+    bool leaf = false;
+};
+
+bool writeMainFloraIds(const MainFloraIdCaptureConfig& config,
+    const R4FloraViewState& view, const std::vector<CapturedMainFloraDraw>& rows,
+    const std::size_t culled)
+{
+    const auto outputPath = config.directory /
+        ("main-flora-ids-frame-" + std::to_string(config.frame) + ".csv");
+    auto partialPath = outputPath;
+    partialPath += ".partial";
+    std::ofstream output(partialPath, std::ios::binary | std::ios::trunc);
+    if (!output)
+        return false;
+    const auto& settings = view.ssaObserver;
+    output << "schema,main-flora-id-observer/v1\n"
+           << "engine_frame," << view.engineFrame << '\n'
+           << "extent," << settings.width << ',' << settings.height << '\n'
+           << "admitted," << rows.size() + culled << '\n'
+           << "submitted," << rows.size() << '\n'
+           << "culled," << culled << '\n';
+    writeFloatBits(output, "view_bits", view.view);
+    writeFloatBits(output, "projection_bits", view.projection);
+    writeFloatBits(output, "eye_bits", view.eye);
+    writeFloatBits(output, "ssa_settings_bits", std::array<float, 7>{
+        settings.fovDegrees, settings.geometryLod, settings.discardPixels,
+        settings.discardExponent, settings.discardFadeK,
+        settings.screenFactor, settings.effectiveDiscard});
+    output << "visual_id,material\n";
+    for (const auto& row : rows)
+        output << row.visualId << ',' << (row.leaf ? "leaf" : "trunk") << '\n';
+    output << "encode_complete," << rows.size() << '\n';
+    output.close();
+    if (!output)
+        return false;
+    std::error_code renameError;
+    std::filesystem::rename(partialPath, outputPath, renameError);
+    return !renameError;
+}
 
