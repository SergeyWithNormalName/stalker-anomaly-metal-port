+        std::uint32_t bits = 0u;
+        std::memcpy(&bits, static_cast<const unsigned char*>(values) + index * sizeof(float), sizeof(bits));
+        std::fprintf(stderr, "%s%08x", index ? "." : "", bits);
+    }
+}
