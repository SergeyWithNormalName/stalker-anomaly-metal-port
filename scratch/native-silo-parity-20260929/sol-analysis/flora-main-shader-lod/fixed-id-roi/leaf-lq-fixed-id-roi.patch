+struct FixedLeafLqRoiFixture
+{
+    std::array<std::uint32_t, 16> viewBits{};
+    std::array<std::uint32_t, 16> projectionBits{};
+    std::array<std::uint32_t, 3> eyeBits{};
+    std::unordered_set<std::uint32_t> visualIds;
+};
+
+std::vector<std::string> splitCsvRow(const std::string& row)
+{
+    std::vector<std::string> fields;
+    std::size_t begin = 0;
+    for (;;)
+    {
+        const std::size_t comma = row.find(',', begin);
+        fields.emplace_back(row.substr(begin, comma == std::string::npos ? comma : comma - begin));
+        if (comma == std::string::npos)
+            break;
+        begin = comma + 1u;
+    }
+    return fields;
+}
+
+bool parseHexWord(const std::string& value, std::uint32_t& result)
+{
+    if (value.size() != 8u)
+        return false;
+    result = 0;
+    for (const char digit : value)
+    {
+        std::uint32_t nibble = 0;
+        if (digit >= '0' && digit <= '9') nibble = std::uint32_t(digit - '0');
+        else if (digit >= 'a' && digit <= 'f') nibble = std::uint32_t(digit - 'a' + 10);
+        else if (digit >= 'A' && digit <= 'F') nibble = std::uint32_t(digit - 'A' + 10);
+        else return false;
+        result = (result << 4u) | nibble;
+    }
+    return true;
+}
+
+bool parseUnsignedWord(const std::string& value, std::uint32_t& result)
+{
+    if (value.empty())
+        return false;
+    std::uint64_t parsed = 0;
+    for (const char digit : value)
+    {
+        if (digit < '0' || digit > '9')
+            return false;
+        parsed = parsed * 10u + std::uint32_t(digit - '0');
+        if (parsed > std::numeric_limits<std::uint32_t>::max())
+            return false;
+    }
+    result = std::uint32_t(parsed);
+    return true;
+}
+
+template <std::size_t N>
+bool parseBitsRow(const std::vector<std::string>& fields, const char* key,
+    std::array<std::uint32_t, N>& output)
+{
+    if (fields.size() != N + 1u || fields[0] != key)
+        return false;
+    for (std::size_t i = 0; i < N; ++i)
+        if (!parseHexWord(fields[i + 1u], output[i]))
+            return false;
+    return true;
+}
+
+bool readFixedLeafLqRoiFixture(const std::filesystem::path& path,
+    FixedLeafLqRoiFixture& fixture, std::string& error)
+{
+    std::ifstream input(path, std::ios::binary);
+    if (!input)
+    {
+        error = "fixed-ID Flora LQ fixture is unavailable";
+        return false;
+    }
+    std::string row;
+    if (!std::getline(input, row) || row != "schema,main-flora-leaf-lq-fixed-id/v1")
+    {
+        error = "fixed-ID Flora LQ fixture schema is invalid";
+        return false;
+    }
+    if (!std::getline(input, row) || row != "visual_id_count,1856")
+    {
+        error = "fixed-ID Flora LQ fixture must contain exactly 1856 IDs";
+        return false;
+    }
+    if (!std::getline(input, row) || !parseBitsRow(splitCsvRow(row), "view_bits", fixture.viewBits) ||
+        !std::getline(input, row) || !parseBitsRow(splitCsvRow(row), "projection_bits", fixture.projectionBits) ||
+        !std::getline(input, row) || !parseBitsRow(splitCsvRow(row), "eye_bits", fixture.eyeBits) ||
+        !std::getline(input, row) || row != "visual_id,material")
+    {
+        error = "fixed-ID Flora LQ fixture view header is malformed";
+        return false;
+    }
+    while (std::getline(input, row))
+    {
+        const std::vector<std::string> fields = splitCsvRow(row);
+        std::uint32_t visualId = 0;
+        if (fields.size() != 2u || fields[1] != "leaf" ||
+            !parseUnsignedWord(fields[0], visualId) || !fixture.visualIds.emplace(visualId).second)
+        {
+            error = "fixed-ID Flora LQ fixture contains an invalid, non-leaf, or duplicate ID";
+            return false;
+        }
+    }
+    if (!input.eof() || fixture.visualIds.size() != kFixedLeafLqRoiVisualCount)
+    {
+        error = "fixed-ID Flora LQ fixture read failed or its ID count changed";
+        return false;
+    }
+    return true;
+}
+
+template <std::size_t N>
+bool floatArrayMatchesBits(const std::array<float, N>& values,
+    const std::array<std::uint32_t, N>& bits)
+{
+    for (std::size_t i = 0; i < N; ++i)
+    {
+        std::uint32_t actual = 0;
+        std::memcpy(&actual, &values[i], sizeof(actual));
+        if (actual != bits[i])
+            return false;
+    }
+    return true;
+}
+
+bool fixedLeafLqRoiViewMatches(const FixedLeafLqRoiFixture& fixture,
+    const R4FloraViewState& view)
+{
+    return view.valid && view.windValid && floatArrayMatchesBits(view.view, fixture.viewBits) &&
+        floatArrayMatchesBits(view.projection, fixture.projectionBits) &&
+        floatArrayMatchesBits(view.eye, fixture.eyeBits);
+}
