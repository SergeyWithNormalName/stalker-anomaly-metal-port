+        try
+        {
+            std::unordered_map<std::string, std::size_t> groupByKey;
+            std::vector<std::vector<std::size_t>> groups;
+            groupByKey.reserve(m_impl->draws.size());
+            groups.reserve(m_impl->draws.size());
+            for (std::size_t drawIndex = 0u; drawIndex < m_impl->draws.size(); ++drawIndex)
+            {
+                const Impl::Draw& draw = m_impl->draws[drawIndex];
+                const std::shared_ptr<IR4GraphicsPipeline>& pipeline =
+                    draw.material == Impl::Material::LeafBump ? m_impl->leafPipeline : m_impl->trunkPipeline;
+                std::string key;
+                key.reserve(128u + draw.textures.size() * sizeof(void*));
+                const auto append = [&key](const auto& value) {
+                    key.append(reinterpret_cast<const char*>(&value), sizeof(value));
+                };
+                const void* vertices = draw.vertices.get();
+                const void* indices = draw.indices.get();
+                const void* pso = pipeline.get();
+                const void* waves = m_impl->wavesTexture.get();
+                const void* sampler = m_impl->sampler.get();
+                append(vertices); append(indices); append(pso); append(waves); append(sampler);
+                append(draw.vertexBase); append(draw.vertexCount); append(draw.indexBase);
+                append(draw.indexBufferOffset); append(draw.indexCount); append(draw.indexType);
+                append(draw.baseVertex); append(draw.material); append(draw.alphaTested); append(draw.objectLod);
+                const std::size_t textureCount = draw.textures.size();
+                append(textureCount);
+                for (const auto& texture : draw.textures)
+                {
+                    const void* identity = texture.get();
+                    append(identity);
+                }
+                const auto found = groupByKey.find(key);
+                if (found != groupByKey.end())
+                    groups[found->second].push_back(drawIndex);
+                else
+                {
+                    const std::size_t groupIndex = groups.size();
+                    groupByKey.emplace(std::move(key), groupIndex);
+                    groups.push_back({drawIndex});
+                }
+            }
+            exactGroupCount = groups.size();
+            order.reserve(m_impl->draws.size());
+            for (const auto& group : groups)
+                order.insert(order.end(), group.begin(), group.end());
+        }
+        catch (const std::exception& exception)
+        {
+            error = std::string("main Flora exact-key reorder allocation failed: ") + exception.what();
+            m_telemetry = savedTelemetry;
+            return false;
+        }
+    }
+
+    const bool drawn = DrawIntoActiveGBufferOrdered(backend, view,
+        groupExactKeys ? &order : nullptr, error);
+    sampledTelemetry = m_telemetry;
+    m_telemetry = savedTelemetry;
+    return drawn;
+}
