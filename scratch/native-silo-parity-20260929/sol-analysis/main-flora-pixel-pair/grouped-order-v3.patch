+bool MetalR4FloraAdapter::DrawIntoActiveGBufferForValidation(IR4Backend& backend,
+    const R4FloraViewState& view, const bool groupExactKeys,
+    Telemetry& sampledTelemetry, std::size_t& exactGroupCount, std::string& error)
+{
+    exactGroupCount = 0u;
+    if (!m_ready || !view.valid)
