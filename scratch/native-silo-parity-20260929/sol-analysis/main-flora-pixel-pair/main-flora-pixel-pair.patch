+        return false;
+    }
+    readback.label = @"R4 main Flora exact depth-stencil pair readback";
+    const MTLOrigin origin = MTLOriginMake(0u, 0u, 0u);
+    const MTLSize extent = MTLSizeMake(width, height, 1u);
+    const auto encodeOne = [&](id<MTLTexture> texture, const NSUInteger base) {
+        [blit copyFromTexture:texture sourceSlice:0u sourceLevel:0u sourceOrigin:origin
+            sourceSize:extent toBuffer:readback destinationOffset:base
+            destinationBytesPerRow:depthRow destinationBytesPerImage:depthPlane
+            options:MTLBlitOptionDepthFromDepthStencil];
+        [blit copyFromTexture:texture sourceSlice:0u sourceLevel:0u sourceOrigin:origin
+            sourceSize:extent toBuffer:readback destinationOffset:base + depthPlane
+            destinationBytesPerRow:stencilRow destinationBytesPerImage:stencilPlane
+            options:MTLBlitOptionStencilFromDepthStencil];
+    };
+    encodeOne(first, 0u);
+    encodeOne(second, oneTextureBytes);
+    [blit endEncoding];
+
+    struct PairContext
+    {
+        id<MTLBuffer> readback;
+        NSUInteger width = 0u, height = 0u, depthRow = 0u, stencilRow = 0u;
+        NSUInteger depthPlane = 0u, stencilPlane = 0u, oneTextureBytes = 0u;
+        std::uint32_t frame = 0u;
+        std::string phase, outputDirectory;
+        bool expectEqual = false, expectDifferent = false;
+    };
+    auto context = std::make_shared<PairContext>();
+    context->readback = readback; context->width = width; context->height = height;
+    context->depthRow = depthRow; context->stencilRow = stencilRow;
+    context->depthPlane = depthPlane; context->stencilPlane = stencilPlane;
+    context->oneTextureBytes = oneTextureBytes; context->frame = descriptor.engineFrame;
+    context->phase = descriptor.phase; context->outputDirectory = descriptor.outputDirectory;
+    context->expectEqual = descriptor.expectEqual; context->expectDifferent = descriptor.expectDifferent;
+    [commandBuffer addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+        const bool commandSucceeded = completed.status == MTLCommandBufferStatusCompleted;
+        const auto* bytes = static_cast<const std::uint8_t*>(context->readback.contents);
+        std::uint64_t depthMismatchPixels = 0u, depthMismatchBytes = 0u;
+        std::uint64_t stencilMismatchPixels = 0u, stencilMismatchBytes = 0u;
+        if (commandSucceeded && bytes)
+        {
+            for (NSUInteger y = 0u; y < context->height; ++y)
+            {
+                const auto* firstDepthRow = bytes + y * context->depthRow;
+                const auto* secondDepthRow = bytes + context->oneTextureBytes + y * context->depthRow;
+                const auto* firstStencilRow = bytes + context->depthPlane + y * context->stencilRow;
+                const auto* secondStencilRow = bytes + context->oneTextureBytes + context->depthPlane + y * context->stencilRow;
+                for (NSUInteger x = 0u; x < context->width; ++x)
+                {
+                    std::uint64_t depthLocal = 0u;
+                    for (NSUInteger component = 0u; component < sizeof(float); ++component)
+                        if (firstDepthRow[x * sizeof(float) + component] !=
+                            secondDepthRow[x * sizeof(float) + component]) ++depthLocal;
+                    if (depthLocal) ++depthMismatchPixels;
+                    depthMismatchBytes += depthLocal;
+                    if (firstStencilRow[x] != secondStencilRow[x])
+                    { ++stencilMismatchPixels; ++stencilMismatchBytes; }
+                }
+            }
+        }
+        const bool hasDifference = depthMismatchBytes != 0u || stencilMismatchBytes != 0u;
+        const bool passed = commandSucceeded && (!context->expectEqual || !hasDifference) &&
+            (!context->expectDifferent || hasDifference);
+        const std::filesystem::path path = std::filesystem::path(context->outputDirectory) /
+            ("r4_depth_stencil_pair_" + safeFilenamePart(context->phase) + "_frame_" +
+                std::to_string(context->frame) + ".json");
+        std::error_code fsError;
+        std::filesystem::create_directories(path.parent_path(), fsError);
+        std::lock_guard<std::mutex> outputLock(outputMutex());
+        std::ofstream report(path);
+        if (report)
+        {
+            report << "{\n  \"schema\": \"r4-depth-stencil-pair/v1\",\n"
+                << "  \"frame\": " << context->frame << ",\n"
+                << "  \"phase\": \"" << jsonEscape(context->phase) << "\",\n"
+                << "  \"command_completed\": " << (commandSucceeded ? "true" : "false") << ",\n"
+                << "  \"expect_equal\": " << (context->expectEqual ? "true" : "false") << ",\n"
+                << "  \"expect_different\": " << (context->expectDifferent ? "true" : "false") << ",\n"
+                << "  \"depth_mismatch_pixel_count\": " << depthMismatchPixels << ",\n"
+                << "  \"depth_mismatch_byte_count\": " << depthMismatchBytes << ",\n"
+                << "  \"stencil_mismatch_pixel_count\": " << stencilMismatchPixels << ",\n"
+                << "  \"stencil_mismatch_byte_count\": " << stencilMismatchBytes << ",\n"
+                << "  \"result\": \"" << (passed ? "PASS" : "FAIL") << "\"\n}\n";
+        }
+        std::cerr << "R4 depth/stencil pair validation " << context->phase << " frame "
+            << context->frame << " " << (passed ? "PASS" : "FAIL") << " report=" << path.string() << std::endl;
+    }];
+    return true;
+}
