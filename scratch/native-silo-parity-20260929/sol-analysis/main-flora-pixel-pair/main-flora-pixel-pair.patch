+        if (!backend.CopyTexture2D(scene.gBufferTargets[i], targets->offColor[i], error) ||
+            !backend.CopyTexture2D(targets->offColor[i], targets->onColor[i], error))
+            return failOpen("copy-mrt", error);
+    }
+    if (!backend.CopyTexture2D(scene.depthTarget, targets->offDepthStencil, error) ||
+        !backend.CopyTexture2D(targets->offDepthStencil, targets->onDepthStencil, error))
+        return failOpen("copy-depth-stencil", error);
+
+    static const char* labels[4] = {"position", "diffuse", "auxiliary", "motion"};
+    for (std::size_t i = 0u; i < 4u; ++i)
+    {
+        const std::string phase = "main-flora-copy-identity-mrt-" + std::to_string(i);
+        if (!validateMainFloraColorPair(backend, scene.gBufferTargets[i], targets->offColor[i],
+                "base", "off-copy", phase.c_str(), view.engineFrame, directory,
+                true, false, false, error))
+            return failOpen("verify-copy-mrt", error);
+    }
+    if (!validateMainFloraDepthPair(backend, scene.depthTarget, targets->offDepthStencil,
+            "main-flora-copy-identity-depth-stencil", view.engineFrame, directory, true, false, error))
+        return failOpen("verify-copy-depth-stencil", error);
+
+    const auto drawBranch = [&](const char* label,
+        const std::array<std::shared_ptr<IR4Texture>, 4>& colors,
+        const std::shared_ptr<IR4Texture>& depthStencil) {
+        R4RenderPassDesc branch = productionPass;
+        branch.label = label; branch.useDrawable = false;
+        for (std::size_t i = 0u; i < branch.colorAttachments.size(); ++i)
+        {
+            branch.colorAttachments[i].texture = colors[i];
+            branch.colorAttachments[i].loadAction = R4LoadAction::Load;
+            branch.colorAttachments[i].storeAction = R4StoreAction::Store;
+        }
+        branch.depthStencilAttachment.texture = depthStencil;
+        branch.depthStencilAttachment.depthLoadAction = R4LoadAction::Load;
+        branch.depthStencilAttachment.depthStoreAction = R4StoreAction::Store;
+        branch.depthStencilAttachment.stencilLoadAction = R4LoadAction::Load;
+        branch.depthStencilAttachment.stencilStoreAction = R4StoreAction::Store;
