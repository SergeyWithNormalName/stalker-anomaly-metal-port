+        first.textureType != MTLTextureType2D || second.textureType != MTLTextureType2D ||
+        first.pixelFormat != MTLPixelFormatDepth32Float_Stencil8 ||
+        second.pixelFormat != MTLPixelFormatDepth32Float_Stencil8 ||
+        first.width == 0u || first.height == 0u || first.width != second.width ||
+        first.height != second.height)
+    {
+        error = "R4 depth/stencil pair validation requires matching non-empty D32S8 textures, phase, and output directory";
+        return false;
+    }
