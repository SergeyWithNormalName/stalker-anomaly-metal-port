+    }
+    std::fprintf(stderr, "METAL_FLORA_MAIN_PIXEL_PAIR frame=%u mode=off-off submitted=1 output=%s\n",
+        view.engineFrame, directory);
+    if (!resumeProductionPass())
+        return false;
+    return true;
+}
