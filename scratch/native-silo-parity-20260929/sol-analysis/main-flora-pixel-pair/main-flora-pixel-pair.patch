+    const NSUInteger width = first.width, height = first.height;
+    if (width > std::numeric_limits<NSUInteger>::max() / sizeof(float))
+    { error = "R4 depth/stencil pair row size overflow"; return false; }
+    const NSUInteger depthRow = alignedRowBytes(width * sizeof(float));
+    const NSUInteger stencilRow = alignedRowBytes(width);
+    if (height > std::numeric_limits<NSUInteger>::max() / depthRow ||
+        height > std::numeric_limits<NSUInteger>::max() / stencilRow)
+    { error = "R4 depth/stencil pair readback size overflow"; return false; }
+    const NSUInteger depthPlane = depthRow * height;
+    const NSUInteger stencilPlane = stencilRow * height;
+    if (depthPlane > std::numeric_limits<NSUInteger>::max() - stencilPlane ||
+        depthPlane + stencilPlane > std::numeric_limits<NSUInteger>::max() / 2u)
+    { error = "R4 depth/stencil pair total size overflow"; return false; }
+    const NSUInteger oneTextureBytes = depthPlane + stencilPlane;
+    const NSUInteger totalBytes = oneTextureBytes * 2u;
