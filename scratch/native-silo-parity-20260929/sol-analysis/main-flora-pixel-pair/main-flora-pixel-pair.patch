+            directory, false, true, true, error) ||
+        !validateMainFloraDepthPair(backend, targets->offDepthStencil, targets->onDepthStencil,
+            "main-flora-off-off-depth-stencil", view.engineFrame, directory, true, false, error) ||
+        !validateMainFloraDepthPair(backend, scene.depthTarget, targets->offDepthStencil,
+            "main-flora-nonblank-depth-stencil-delta", view.engineFrame, directory, false, true, error))
+        return failOpen("compare-depth-or-delta", error);
+
+    std::ofstream manifest(std::filesystem::path(directory) /
+        ("main-flora-off-off-frame-" + std::to_string(view.engineFrame) + ".json"));
+    if (manifest)
+    {
+        manifest << std::setprecision(std::numeric_limits<float>::max_digits10)
+            << "{\n  \"schema\": \"main-flora-off-off-pixel-pair/v1\",\n"
+            << "  \"frame\": " << view.engineFrame << ",\n"
+            << "  \"control\": \"same callback and frozen R4FloraViewState in both branches\",\n"
+            << "  \"time_seconds\": " << frozenFloraView.timeSeconds << ",\n"
+            << "  \"wind_valid\": " << (frozenFloraView.windValid ? "true" : "false") << ",\n"
+            << "  \"static_globals_present\": " << (frozenFloraView.staticGlobals ? "true" : "false") << ",\n";
+        const auto writeFloatArray = [&manifest](const char* key, const auto& values) {
+            manifest << "  \"" << key << "\": [";
+            for (std::size_t i = 0u; i < values.size(); ++i)
+                manifest << (i ? "," : "") << values[i];
+            manifest << "],\n";
+        };
+        writeFloatArray("view", frozenFloraView.view);
+        writeFloatArray("projection", frozenFloraView.projection);
+        writeFloatArray("previous_view", frozenFloraView.previousView);
+        writeFloatArray("previous_projection", frozenFloraView.previousProjection);
+        writeFloatArray("wind_params", frozenFloraView.windParams);
+        writeFloatArray("wind_setup_trees", frozenFloraView.windSetupTrees);
+        writeFloatArray("wind_animation", frozenFloraView.windAnimation);
