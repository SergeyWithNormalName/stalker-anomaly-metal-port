+        return true;
+    };
+    if (!drawBranch("R4 main Flora pixel-pair OFF control", targets->offColor, targets->offDepthStencil))
+        return failOpen("draw-off", error);
+    if (!drawBranch("R4 main Flora pixel-pair ON control", targets->onColor, targets->onDepthStencil))
+        return failOpen("draw-on", error);
+
+    for (std::size_t i = 0u; i < 4u; ++i)
+    {
+        const std::string phase = "main-flora-off-off-mrt-" + std::to_string(i);
+        if (!validateMainFloraColorPair(backend, targets->offColor[i], targets->onColor[i],
+                "off", "on-control", phase.c_str(), view.engineFrame, directory,
+                true, false, true, error))
+            return failOpen("compare-mrt", error);
+    }
+    if (!validateMainFloraColorPair(backend, scene.gBufferTargets[0], targets->offColor[0],
