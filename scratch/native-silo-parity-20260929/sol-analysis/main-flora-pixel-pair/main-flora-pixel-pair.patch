+struct MainFloraPixelPairTargets
+{
+    std::array<std::shared_ptr<IR4Texture>, 4> offColor, onColor;
+    std::shared_ptr<IR4Texture> offDepthStencil, onDepthStencil;
+};
+
+bool ensureMainFloraPixelPairTargets(IR4Backend& backend, LevelScene& scene,
+    MainFloraPixelPairTargets& targets, std::string& error)
+{
+    if (scene.gBufferTargets.size() != 4u || !scene.depthTarget)
+    { error = "main Flora pixel pair requires four G-buffer targets and D32S8"; return false; }
+    bool reusable = static_cast<bool>(targets.offDepthStencil) && static_cast<bool>(targets.onDepthStencil);
+    for (std::size_t i = 0u; reusable && i < 4u; ++i)
+        reusable = targets.offColor[i] && targets.onColor[i] &&
+            sameTextureDescriptor(targets.offColor[i]->Descriptor(), scene.gBufferTargets[i]->Descriptor()) &&
+            sameTextureDescriptor(targets.onColor[i]->Descriptor(), scene.gBufferTargets[i]->Descriptor());
+    reusable = reusable && sameTextureDescriptor(targets.offDepthStencil->Descriptor(), scene.depthTarget->Descriptor()) &&
+        sameTextureDescriptor(targets.onDepthStencil->Descriptor(), scene.depthTarget->Descriptor());
+    if (reusable) return true;
+
+    MainFloraPixelPairTargets replacement;
+    for (std::size_t i = 0u; i < 4u; ++i)
+    {
+        R4Texture2DDesc desc = scene.gBufferTargets[i]->Descriptor();
+        static const char* offLabels[4] = {"R4 main Flora OFF G-buffer 0", "R4 main Flora OFF G-buffer 1",
+            "R4 main Flora OFF G-buffer 2", "R4 main Flora OFF G-buffer 3"};
+        static const char* onLabels[4] = {"R4 main Flora ON G-buffer 0", "R4 main Flora ON G-buffer 1",
+            "R4 main Flora ON G-buffer 2", "R4 main Flora ON G-buffer 3"};
+        desc.label = offLabels[i];
+        replacement.offColor[i] = backend.Resources().CreateTexture2D(desc, error);
+        if (!replacement.offColor[i]) return false;
+        desc.label = onLabels[i];
+        replacement.onColor[i] = backend.Resources().CreateTexture2D(desc, error);
+        if (!replacement.onColor[i]) return false;
+    }
+    R4Texture2DDesc depthDesc = scene.depthTarget->Descriptor();
+    depthDesc.label = "R4 main Flora OFF pixel-pair depth stencil";
+    replacement.offDepthStencil = backend.Resources().CreateTexture2D(depthDesc, error);
+    if (!replacement.offDepthStencil) return false;
+    depthDesc.label = "R4 main Flora ON pixel-pair depth stencil";
+    replacement.onDepthStencil = backend.Resources().CreateTexture2D(depthDesc, error);
+    if (!replacement.onDepthStencil) return false;
+    targets = std::move(replacement);
+    return true;
+}
+
+bool validateMainFloraColorPair(IR4Backend& backend,
+    const std::shared_ptr<IR4Texture>& first, const std::shared_ptr<IR4Texture>& second,
+    const char* firstLabel, const char* secondLabel, const char* phase,
+    std::uint32_t frame, const std::string& outputDirectory,
+    bool expectEqual, bool expectDifferent, bool writeImages, std::string& error)
+{
+    R4TemporalTextureValidationDesc desc;
+    desc.textures = {first, second}; desc.labels = {firstLabel, secondLabel};
+    desc.engineFrame = frame; desc.phase = phase; desc.outputDirectory = outputDirectory;
+    desc.expectFinite = true; desc.expectEqualPair = expectEqual;
+    desc.expectDifferentPair = expectDifferent; desc.writeImages = writeImages;
+    return backend.ValidateTemporalTextures(desc, error);
+}
+
+bool validateMainFloraDepthPair(IR4Backend& backend,
+    const std::shared_ptr<IR4Texture>& first, const std::shared_ptr<IR4Texture>& second,
+    const char* phase, std::uint32_t frame, const std::string& outputDirectory,
+    bool expectEqual, bool expectDifferent, std::string& error)
+{
+    R4DepthStencilPairValidationDesc desc;
+    desc.engineFrame = frame; desc.phase = phase; desc.outputDirectory = outputDirectory;
+    desc.expectEqual = expectEqual; desc.expectDifferent = expectDifferent;
+    return backend.ValidateDepthStencilPair(first, second, desc, error);
+}
