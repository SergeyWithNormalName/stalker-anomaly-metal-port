+
+bool CResourceManager::InspectShaderScriptOverrides(const xr_vector<shared_str>& names,
+    xr_vector<bool>& overrides)
+{
+    overrides.clear();
+    if (!::Render)
+        return false;
+    CResourceManager inspection;
+    inspection.LSVM = nullptr;
+    bool complete = false;
+    try
+    {
+        complete = inspection.LS_LoadImpl(true);
+        if (complete)
+        {
+            for (const auto& name : names)
+            {
+                if (!name.c_str() || !name.size() || name.size() >= sizeof(string256))
+                {
+                    complete = false;
+                    break;
+                }
+                string256 route;
+                xr_strcpy(route, name.c_str());
+                for (char* c = route; *c; ++c)
+                    if (*c == '\\') *c = '_';
+                if (!InspectionNamespaceKnown(inspection.LSVM, route))
+                {
+                    complete = false;
+                    break;
+                }
+                overrides.push_back(inspection._lua_HasShader(name.c_str()) != FALSE);
+            }
+        }
+    }
+    catch (...)
+    {
+        complete = false;
+    }
+    if (inspection.LSVM)
+        inspection.LS_Unload();
+    if (!complete || overrides.size() != names.size())
+    {
+        overrides.clear();
+        return false;
+    }
+    return true;
 }
 
