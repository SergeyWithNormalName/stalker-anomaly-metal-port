+struct R4StaticVisualSsaSettings
+{
+    std::uint32_t engineFrame = 0;
+    float discard = 0.0f;
+    float fadeK = 1.0f;
+    float exponent = 1.0f;
+    bool valid = false;
+};
+
+inline std::uint32_t R4SourceSphereHash(const std::array<float, 4>& sphere)
+{
+    std::array<std::uint32_t, 3> bits{};
+    std::memcpy(bits.data(), sphere.data(), sizeof(bits));
+    std::uint32_t hash = bits[0] * 73856093u ^ bits[1] * 19349663u ^ bits[2] * 83492791u;
+    hash ^= hash >> 16;
+    hash *= 0x85ebca6bu;
+    hash ^= hash >> 13;
+    hash *= 0xc2b2ae35u;
+    hash ^= hash >> 16;
+    return hash;
+}
+
+// Match the source whole-visual SSA/thinning rule. Unknown and numerically
+// marginal cases keep drawing. Callers must separately qualify material and
+// visual exceptions; a vertex AABB is never a substitute for the OGF sphere.
+inline bool R4SourceStaticSsaReject(const std::array<float, 4>& sphere,
+    const std::uint32_t sphereHash, const std::array<float, 3>& eye,
+    const R4StaticVisualSsaSettings& settings)
+{
+    if (!settings.valid || !std::isfinite(settings.discard) || settings.discard <= 0.0f ||
+        !std::isfinite(settings.fadeK) || settings.fadeK < 1.0f ||
+        !std::isfinite(settings.exponent) || settings.exponent <= 0.0f ||
+        !std::isfinite(sphere[3]) || sphere[3] <= 0.0f)
+        return false;
+    for (std::size_t axis = 0; axis < 3u; ++axis)
+        if (!std::isfinite(sphere[axis]) || !std::isfinite(eye[axis]))
+            return false;
+    const float x = eye[0] - sphere[0], y = eye[1] - sphere[1], z = eye[2] - sphere[2];
+    const float distanceSquared = x * x + y * y + z * z + 0.0000100f;
+    const float ssa = sphere[3] * sphere[3] / distanceSquared;
+    if (!std::isfinite(distanceSquared) || distanceSquared <= 0.0f || !std::isfinite(ssa))
+        return false;
+    const float guard = settings.discard * (64.0f * std::numeric_limits<float>::epsilon());
+    if (ssa < settings.discard - guard)
+        return true;
+    const float fadeStart = settings.discard * settings.fadeK;
+    if (!std::isfinite(fadeStart) || fadeStart <= settings.discard ||
+        ssa <= settings.discard + guard || ssa >= fadeStart - guard * settings.fadeK)
+        return false;
+    const float survival = (ssa - settings.discard) / (fadeStart - settings.discard);
+    const float probability = std::pow(survival, settings.exponent);
+    const float value = static_cast<float>(sphereHash) * (1.0f / 4294967296.0f);
+    return std::isfinite(probability) && value > probability + 0.000001f;
+}
