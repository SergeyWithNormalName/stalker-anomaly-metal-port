+namespace
+{
+struct ShaderInspectionLoad
+{
+    LPCSTR path;
+    LPCSTR nameSpace;
+    bool loaded;
+};
+
+int LoadShaderForInspection(lua_State* vm)
+{
+    auto* request = static_cast<ShaderInspectionLoad*>(lua_touserdata(vm, 1));
+    request->loaded = Script::bfLoadFileIntoNamespace(vm, request->path, request->nameSpace, true);
+    return 0;
+}
+
+// The source lookup can fatal on a namespace replaced by a non-table. Such
+// scripts, and metatable-dependent routes, are unknown to this optional gate.
+bool InspectionNamespaceKnown(lua_State* vm, LPCSTR name)
+{
+    const int top = lua_gettop(vm);
+    lua_pushstring(vm, "_G");
+    lua_rawget(vm, LUA_GLOBALSINDEX);
+    bool known = lua_istable(vm, -1);
+    LPCSTR part = name;
+    while (known && part[0])
+    {
+        if (lua_getmetatable(vm, -1))
+        {
+            known = false;
+            break;
+        }
+        LPCSTR dot = strchr(part, '.');
+        lua_pushlstring(vm, part, dot ? size_t(dot - part) : strlen(part));
+        lua_rawget(vm, -2);
+        if (lua_isnil(vm, -1))
+            break; // The source predicate returns false for a missing namespace.
+        known = lua_istable(vm, -1);
+        if (!dot)
+            break;
+        part = dot + 1;
+        if (!part[0])
+            known = false;
+    }
+    lua_settop(vm, top);
+    return known;
+}
+}
