+struct alignas(16) Matrix4
+{
+	float elements[16]{};
+};
+
+struct Stamp
+{
+	std::array<float, 16> wvp{};
+	std::array<float, 2> jitter{};
+	std::uint64_t scope = 0;
+	std::uint32_t frame = UINT32_MAX;
+	bool valid = false;
